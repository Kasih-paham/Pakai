-- =====================================================================
-- SkyP TEST LOADER - hanya untuk tes sendiri sebelum upload ke Cloudflare.
-- JANGAN dibagikan ke buyer (core.lua tidak punya cek key, key dipegang loader skyp-guard).
-- =====================================================================
-- Cara pakai: isi pengaturan di bawah, lalu execute file ini di executor.
--   SUMBER = "file"   -> baca core.lua dari folder workspace executor (paling aman, tanpa GitHub)
--   SUMBER = "github" -> download dari repo GitHub (repo PRIVAT: isi TOKEN; repo publik: TOKEN kosong)
local SUMBER = "file"
local FILE   = "SkyP/core.lua"                  -- workspace/SkyP/core.lua
local REPO   = "SkyP-Hub/NAMA-REPO"             -- pemilik/nama repo
local CABANG = "main"
local PATH   = "core.lua"                       -- lokasi core.lua di dalam repo
local TOKEN  = ""                               -- fine-grained token (read-only, 1 repo). Kosong = repo publik
local VERSI  = "v2.9-test"
-- =====================================================================

local function info(t)
    warn("[SkyP TEST] " .. t)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "SkyP TEST", Text = t, Duration = 8 })
    end)
end

local function ambil()
    if SUMBER == "file" then
        if type(readfile) ~= "function" then return nil, "executor tidak punya readfile" end
        local ok, src = pcall(readfile, FILE)
        if not ok or type(src) ~= "string" or src == "" then return nil, "file " .. FILE .. " tidak ada / kosong" end
        return src
    end
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if TOKEN ~= "" then
        -- repo privat: lewat API GitHub (butuh header, jadi pakai request)
        if not req then return nil, "executor tidak punya fungsi request (perlu untuk repo privat)" end
        local ok, r = pcall(req, {
            Url = ("https://api.github.com/repos/%s/contents/%s?ref=%s&t=%d"):format(REPO, PATH, CABANG, os.time()),
            Method = "GET",
            Headers = { Authorization = "token " .. TOKEN, Accept = "application/vnd.github.raw", ["User-Agent"] = "SkyP-Test" },
        })
        if not ok or type(r) ~= "table" then return nil, "tidak bisa konek ke GitHub" end
        local code = tonumber(r.StatusCode)
        if code == 401 then return nil, "TOKEN salah / kedaluwarsa" end
        if code == 404 then return nil, "repo / file tidak ketemu (cek REPO, CABANG, PATH, izin token)" end
        if code ~= 200 then return nil, "GitHub membalas " .. tostring(code) end
        return tostring(r.Body or "")
    end
    -- repo publik: link raw (bisa telat update s/d ~5 menit karena cache GitHub)
    local url = ("https://raw.githubusercontent.com/%s/%s/%s?t=%d"):format(REPO, CABANG, PATH, os.time())
    local ok, src = pcall(game.HttpGet, game, url)
    if not ok then return nil, "gagal download: " .. tostring(src) end
    return src
end

local src, why = ambil()
if not src then return info("Gagal ambil core.lua: " .. tostring(why)) end
if src:find("^404: Not Found") then return info("File tidak ketemu di GitHub (cek REPO / PATH)") end

local fn, err = loadstring(src, "=SkyP-core")
if not fn then return info("SYNTAX ERROR: " .. tostring(err)) end

-- Mode GitHub: simpan salinan ke folder Workspace. Setelah pindah world (teleport) game dimuat ulang dan
-- script dijalankan lagi dari file ini (queue_on_teleport), tanpa download ulang. Jadi repo PRIVAT juga bisa.
if SUMBER == "github" then
    local okS, errS = pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("SkyP") then makefolder("SkyP") end
        writefile(FILE, src)
    end)
    if okS then
        info("Salinan disimpan di Workspace/" .. FILE .. " (dipakai untuk lanjut setelah pindah world)")
    else
        info("Gagal simpan salinan (" .. tostring(errS) .. "): Auto Leveling tidak bisa lanjut setelah pindah world")
    end
end

-- data yang biasanya dikirim loader skyp-guard (core memakai 4 field ini)
local SKYP = {
    version = VERSI,
    shared = {},                              -- kosong = SkyUI versi yang ditanam di core
    onStop = {},                              -- di loader asli: dipanggil saat key dicabut
    isAlive = function() return true end,     -- di loader asli: false saat key dicabut
}
info(("core.lua dimuat (%d KB), menjalankan..."):format(math.floor(#src / 1024)))
local ok, e = pcall(fn, SKYP)
if not ok then return info("ERROR saat jalan: " .. tostring(e)) end
info("Jalan. Cek menu SkyP & console (F9) kalau ada yang aneh")
