local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 300 then table.remove(buf, 1) end
end
local function flush() lbl.Text = table.concat(buf, "\n") end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end





local getmt = getrawmetatable or getmetatable
local getup = (debug and debug.getupvalue) or getupvalue
local getups = (debug and debug.getupvalues) or getupvalues

local function ups(f)
    if getups then
        local ok, t = pcall(getups, f)
        if ok and type(t) == "table" then return t end
    end
    local out = {}
    if getup then
        for i = 1, 80 do
            local ok, v = pcall(getup, f, i)
            if not ok then break end
            out[i] = v
        end
    end
    return out
end

local function rawKeys(t, max)
    max = max or 50
    local list, n, nnum = {}, 0, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "number" then nnum = nnum + 1
            else
                local tv = typeof(v)
                local s = tostring(k) .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 18) end
                list[#list + 1] = s
            end
            if n > 400 then break end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci, %d angka) "):format(n, nnum) .. table.concat(list, ", ") .. extra
end

local function upSummary(u)
    local parts = {}
    for i, x in pairs(u) do
        local tx = typeof(x)
        local s = i .. ":" .. tx
        if tx == "number" or tx == "boolean" then s = s .. "=" .. tostring(x)
        elseif tx == "string" then s = s .. "=" .. x:sub(1, 16) end
        parts[#parts + 1] = s
    end
    return table.concat(parts, ", ")
end

local function gridSize(t)
    local rows, cols = 0, 0
    local ok = pcall(function()
        for k, row in next, t do
            if type(k) ~= "number" or type(row) ~= "table" then rows = -999 return end
            rows = rows + 1
            if rows == 1 then for _, x in next, row do cols = cols + 1 if cols > 300 then break end end end
            if rows > 2000 then break end
        end
    end)
    if ok and rows >= 30 and cols >= 30 then return rows, cols end
end

local function main()
    log("getupvalue=" .. tostring(getup ~= nil) .. " getupvalues=" .. tostring(getups ~= nil)
        .. " debug.info=" .. tostring(debug and debug.info ~= nil))
    if not getup and not getups then bad("executor tidak bisa membaca upvalue") return end

    local InvMod
    for _, mod in ipairs(getloadedmodules()) do
        local ok, m = pcall(require, mod)
        if ok and type(m) == "table" then
            local ok2, yes = pcall(function()
                return type(m.room) == "function" and type(m.used) == "function" and type(m.count) == "function" and type(m.new) == "function"
            end)
            if ok2 and yes then InvMod = m break end
        end
    end

    title.Text = "SkyP Debug 12: cari grid & tas..."
    local gc = getgc(true)
    log("getgc: " .. #gc .. " objek")
    local target = {} -- [obj] = label
    local nGrid = 0
    for i, v in ipairs(gc) do
        if i % 2000 == 0 then title.Text = ("SkyP Debug 12: tahap 1 %d%%"):format(math.floor(i / #gc * 100)) task.wait() end
        if type(v) == "table" then
            pcall(function()
                if nGrid < 8 then
                    local r, c = gridSize(v)
                    if r then nGrid = nGrid + 1 target[v] = ("GRID%d %dx%d"):format(nGrid, r, c) end
                end
                if InvMod then
                    local mt = getmt(v)
                    if mt == InvMod or (type(mt) == "table" and rawget(mt, "__index") == InvMod) then target[v] = "TAS" end
                end
            end)
        end
    end
    local labels = {}
    for _, l in pairs(target) do labels[#labels + 1] = l end
    log("target: " .. table.concat(labels, ", "))

    head("FUNGSI YANG MEMEGANG GRID / TAS")
    local holders, hcount, perLabel = {}, 0, {}
    for i, f in ipairs(gc) do
        if i % 1500 == 0 then title.Text = ("SkyP Debug 12: tahap 2 %d%%"):format(math.floor(i / #gc * 100)) task.wait() end
        if type(f) == "function" and hcount < 30 then
            local okC = true
            if iscclosure then okC = not iscclosure(f) end
            if okC then
                local u = ups(f)
                for idx, x in pairs(u) do
                    local l = target[x]
                    if l and (perLabel[l] or 0) < 4 then
                        perLabel[l] = (perLabel[l] or 0) + 1
                        hcount = hcount + 1
                        holders[f] = l
                        local okN, nm = pcall(debug.info, f, "n")
                        local okS, src = pcall(debug.info, f, "s")
                        good(("%s <- fungsi '%s' upvalue #%s | %s"):format(l, tostring(okN and nm or "?"), tostring(idx),
                            tostring(okS and src or "?"):sub(-50)))
                        log("   upvalue: " .. upSummary(u))
                        break
                    end
                end
            end
        end
    end
    if hcount == 0 then bad("tidak ada fungsi yang memegangnya") end

    head("MODUL / TABEL YANG MENYIMPAN FUNGSI ITU")
    local owners = 0
    if next(holders) then
        for i, v in ipairs(gc) do
            if i % 2000 == 0 then title.Text = ("SkyP Debug 12: tahap 3 %d%%"):format(math.floor(i / #gc * 100)) task.wait() end
            if type(v) == "table" and owners < 8 then
                pcall(function()
                    local n = 0
                    for k, x in next, v do
                        n = n + 1
                        if n > 400 then break end
                        if holders[x] then
                            owners = owners + 1
                            good(("O%d %s disimpan di kunci '%s'"):format(owners, holders[x], tostring(k)))
                            log("   tabel: " .. rawKeys(v, 70))
                            break
                        end
                    end
                end)
            end
        end
    end
    if owners == 0 then bad("tidak ada tabel yang menyimpannya") end
    title.Text = "SkyP Debug 12 (selesai)"
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
flush()
