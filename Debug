add("== SkyP Debug ==")
do
    local name = "?"
    if identifyexecutor then
        local ok, n, v = pcall(identifyexecutor)
        if ok then
            name = tostring(n) .. (v and (" " .. tostring(v)) or "")
        end
    end
    add("Executor : " .. name)
    add("-- Fungsi wajib --")
    local wajib = {
        { "getgc", getgc }, { "getconstants", getconsts }, { "debug.info", debug and debug.info },
    }
    local kurang = 0
    for _, f in ipairs(wajib) do
        if not f[2] then
            kurang = kurang + 1
        end
        add(("  %-18s: %s"):format(f[1], yn(f[2])))
    end
    add("-- Fungsi tambahan --")
    for _, f in ipairs({
        { "islclosure", islclosure }, { "isexecutorclosure", isexecutorclosure }, { "getconnections", getconnections },
        { "request", (syn and syn.request) or (http and http.request) or http_request or request },
        { "loadstring", loadstring },
        { "readfile/writefile", readfile and writefile and isfile }, { "queue_on_teleport", queue_on_teleport or queueonteleport },
        { "setclipboard", setclipboard or toclipboard }, { "getcustomasset", getcustomasset }, { "gethui", gethui },
        { "getupvalue", (debug and debug.getupvalue) or getupvalue }, { "setupvalue", (debug and debug.setupvalue) or setupvalue },
    }) do
        add(("  %-18s: %s"):format(f[1], yn(f[2])))
    end
    if kurang > 0 then
        add("KESIMPULAN: executor ini kekurangan " .. kurang .. " fungsi wajib. SkyP tidak bisa terhubung ke game di sini")
    end
end

