local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 400 then table.remove(buf, 1) end
    lbl.Text = table.concat(buf, "\n")
end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end

-- kode yang dijalankan DI DALAM tiap Actor: cari data world / tas / posisi, tulis hasil ke file
local ACTOR_CODE = [==[
local out = {}
local function add(x) out[#out + 1] = tostring(x) end
local function keysOf(t, max)
    local list = {}
    pcall(function()
        for k, v in next, t do
            if type(k) == "string" then list[#list + 1] = k .. ":" .. type(v):sub(1, 1) end
        end
    end)
    table.sort(list)
    while #list > (max or 40) do table.remove(list) end
    return table.concat(list, ", ")
end
local ok, err = pcall(function()
    add("getgc=" .. tostring(getgc ~= nil))
    if not getgc then return end
    local gc = getgc(true)
    add("objek=" .. #gc)
    local nW, nInv, nState, nOther = 0, 0, 0, 0
    for i, v in ipairs(gc) do
        if type(v) == "table" then
            pcall(function()
                if type(rawget(v, "fg")) == "table" and type(rawget(v, "w")) == "number" and rawget(v, "spawn") ~= nil then
                    nW = nW + 1
                    if nW <= 2 then add("WORLD: " .. keysOf(v, 60)) end
                end
                if type(rawget(v, "slots")) == "table" and type(v.count) == "function" then
                    nInv = nInv + 1
                    if nInv <= 2 then add("TAS: " .. keysOf(v, 30)) end
                end
                if type(rawget(v, "state")) == "function" then
                    nState = nState + 1
                    if nState <= 2 then
                        local okS, s = pcall(rawget(v, "state"))
                        add("STATE: " .. (okS and type(s) == "table" and keysOf(s, 25) or tostring(s)))
                    end
                end
                if type(rawget(v, "playerAt")) == "function" then nOther = nOther + 1 end
            end)
        end
    end
    add(("ringkas: world=%d tas=%d state=%d pemain=%d"):format(nW, nInv, nState, nOther))
end)
if not ok then add("ERROR " .. tostring(err)) end
pcall(writefile, "SKYP_FILE", table.concat(out, "\n"))
]==]

local function main()
    head("FUNGSI EXECUTOR")
    local fns = { "getactors", "run_on_actor", "getactorthreads", "run_on_thread", "create_comm_channel",
        "getgc", "getloadedmodules", "getscripts", "getrunningscripts", "writefile", "readfile", "isfile", "delfile",
        "identifyexecutor" }
    for _, n in ipairs(fns) do
        local f = getgenv and getgenv()[n]
        if f == nil then f = rawget(_G, n) end
        if f == nil then pcall(function() f = getfenv(0)[n] end) end
        log(n .. " = " .. tostring(f ~= nil))
    end
    if identifyexecutor then
        local ok, a, b = pcall(identifyexecutor)
        if ok then log("executor: " .. tostring(a) .. " " .. tostring(b or "")) end
    end

    head("ACTOR DI GAME")
    local actors = {}
    for _, root in ipairs({ game:GetService("Players"), game:GetService("ReplicatedFirst"),
        game:GetService("ReplicatedStorage"), game:GetService("StarterPlayer"), workspace }) do
        pcall(function()
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("Actor") then actors[#actors + 1] = d end
            end
        end)
    end
    log("Actor ditemukan: " .. #actors)
    for i, a in ipairs(actors) do
        if i > 15 then log("...") break end
        local scripts = {}
        pcall(function()
            for _, d in ipairs(a:GetDescendants()) do
                if d:IsA("LocalScript") or (d:IsA("Script") and d.RunContext == Enum.RunContext.Client) then
                    scripts[#scripts + 1] = d.Name
                end
            end
        end)
        log(("  %s | %d script: %s"):format(a:GetFullName(), #scripts, table.concat(scripts, ", ", 1, math.min(#scripts, 6))))
    end
    if getactors then
        local ok, list = pcall(getactors)
        log("getactors() = " .. (ok and type(list) == "table" and (#list .. " actor") or tostring(list)))
    end

    head("LOCALSCRIPT YANG JALAN")
    if getscripts or getrunningscripts then
        local ok, list = pcall(getrunningscripts or getscripts)
        if ok and type(list) == "table" then
            local n, shown = 0, 0
            for _, s in ipairs(list) do
                local okp, p = pcall(function() return s:GetFullName() end)
                if okp and (s:IsA("LocalScript") or s:IsA("Script")) and not p:find("CoreGui", 1, true)
                    and not p:find("PlayerModule", 1, true) and not p:find("RbxCharacterSounds", 1, true) then
                    n = n + 1
                    if shown < 15 then
                        shown = shown + 1
                        local actor = s:FindFirstAncestorWhichIsA("Actor")
                        log("  " .. p .. (actor and "  [DI ACTOR]" or ""))
                    end
                end
            end
            log("total: " .. n)
        end
    end

    -- sumber fungsi yang terlihat dari VM ini (kalau script game tidak muncul = game di VM lain)
    head("SUMBER FUNGSI DI VM INI (getgc)")
    if getgc and debug and debug.info then
        local count, okG, gc = {}, pcall(getgc, false)
        if okG then
            for i, f in ipairs(gc) do
                if i % 4000 == 0 then task.wait() end
                if type(f) == "function" then
                    local ok, src = pcall(debug.info, f, "s")
                    if ok and type(src) == "string" and not src:find("CoreGui", 1, true) and not src:find("CorePackages", 1, true) then
                        src = src:sub(1, 60)
                        count[src] = (count[src] or 0) + 1
                    end
                end
            end
            local list = {}
            for k, v in pairs(count) do list[#list + 1] = { k, v } end
            table.sort(list, function(a, b) return a[2] > b[2] end)
            for i = 1, math.min(20, #list) do log(("  %5d  %s"):format(list[i][2], list[i][1])) end
        end
    end

    -- jalankan pemindai di dalam tiap Actor
    head("PINDAI DI DALAM ACTOR")
    local runOn = run_on_actor or (syn and syn.run_on_actor)
    if not runOn then bad("executor tidak punya run_on_actor") return end
    if not (writefile and readfile and isfile) then bad("executor tidak bisa tulis/baca file") return end
    local targets = actors
    if getactors then
        local ok, list = pcall(getactors)
        if ok and type(list) == "table" and #list > 0 then targets = list end
    end
    if #targets == 0 then bad("tidak ada Actor untuk dipindai") return end
    for i, a in ipairs(targets) do
        if i > 8 then break end
        local fname = "skyp_actor_" .. i .. ".txt"
        pcall(function() if isfile(fname) and delfile then delfile(fname) end end)
        local ok, err = pcall(runOn, a, (ACTOR_CODE:gsub("SKYP_FILE", fname)))
        local name = "?"
        pcall(function() name = a:GetFullName() end)
        if not ok then
            bad("  A" .. i .. " " .. name .. ": run_on_actor gagal: " .. tostring(err))
        else
            local t0 = os.clock()
            while os.clock() - t0 < 15 and not (pcall(isfile, fname) and isfile(fname)) do task.wait(0.5) end
            local okR, txt = pcall(readfile, fname)
            if okR and txt then
                good("  A" .. i .. " " .. name .. ":")
                for line in txt:gmatch("[^\n]+") do log("     " .. line) end
            else
                bad("  A" .. i .. " " .. name .. ": tidak ada hasil (15 dtk)")
            end
        end
    end
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
if setclipboard then pcall(setclipboard, table.concat(plain, "\n")) end
