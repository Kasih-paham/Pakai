local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 400 then table.remove(buf, 1) end
    lbl.Text = table.concat(buf, "\n")
end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end



local getmt = getrawmetatable or getmetatable

local function rawKeys(t, max)
    max = max or 50
    local list, n, nnum = {}, 0, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "number" then nnum = nnum + 1
            else
                local tv = typeof(v)
                local s = tostring(k) .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 18) end
                list[#list + 1] = s
            end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci, %d angka) "):format(n, nnum) .. table.concat(list, ", ") .. extra
end

-- kunci yang dipakai SkyP: dibaca biasa (lewat metatable), bukan rawget
local PROBE = { "fg", "bg", "w", "h", "spawn", "name", "state", "addGems", "punchRange", "handPower", "openBackpack",
    "ui", "list", "where", "playerAt", "takeDrop", "dropList", "spliceSeed", "tileChanged", "vendCall", "call", "enter",
    "slots", "capacity", "jammerOn" }
local function probe(t)
    local hit = {}
    for _, k in ipairs(PROBE) do
        local ok, v = pcall(function() return t[k] end)
        if ok and v ~= nil then hit[#hit + 1] = k .. ":" .. typeof(v):sub(1, 3) end
    end
    return hit
end

local function mtDesc(v)
    local ok, mt = pcall(getmt, v)
    if not ok or type(mt) ~= "table" then return "tanpa metatable" end
    local parts = {}
    for _, m in ipairs({ "__index", "__newindex", "__call", "__len", "__iter" }) do
        local x = rawget(mt, m)
        if x ~= nil then parts[#parts + 1] = m .. "=" .. typeof(x) end
    end
    return "metatable: " .. table.concat(parts, ", ")
end

local function main()
    local gc = getgc(true)
    log("getgc: " .. #gc .. " objek")
    local worlds, proxies, probed = {}, {}, {}
    for i, v in ipairs(gc) do
        if i % 3000 == 0 then task.wait() end
        if type(v) == "table" then
            pcall(function()
                if type(rawget(v, "w")) == "number" and type(rawget(v, "h")) == "number" and #worlds < 4 then
                    worlds[#worlds + 1] = v
                end
                local mt = getmt(v)
                if type(mt) == "table" and rawget(mt, "__index") ~= nil and rawget(mt, "__index") ~= mt and #proxies < 300 then
                    proxies[#proxies + 1] = v
                end
            end)
        end
    end

    head("TABEL W/H (calon world)")
    for i, v in ipairs(worlds) do
        log(("W%d %s"):format(i, rawKeys(v, 70)))
        log("   " .. mtDesc(v))
        local hit = probe(v)
        if #hit > 0 then good("   dibaca biasa: " .. table.concat(hit, ", ")) end
        -- tabel di dalamnya: grid?
        pcall(function()
            for k, sub in next, v do
                if type(sub) == "table" then
                    local r0 = rawget(sub, 0) or rawget(sub, 1)
                    local n = 0
                    for _ in next, sub do n = n + 1 if n > 5000 then break end end
                    log(("   [%s] tabel n=%d isi[0/1]=%s"):format(tostring(k), n, typeof(r0)))
                end
            end
        end)
    end

    head("PROXY YANG PUNYA KUNCI SKYP")
    log("jumlah proxy: " .. #proxies)
    local shown = 0
    for _, v in ipairs(proxies) do
        local hit = probe(v)
        if #hit >= 1 and shown < 15 then
            shown = shown + 1
            good(("X%d %s"):format(shown, table.concat(hit, ", ")))
            log("   raw: " .. rawKeys(v, 25))
            log("   " .. mtDesc(v))
            local okI, idx = pcall(function() return rawget(getmt(v), "__index") end)
            if okI and type(idx) == "table" then log("   __index: " .. rawKeys(idx, 40)) end
        end
    end
    if shown == 0 then bad("tidak ada proxy yang punya kunci SkyP") end

    -- semua tabel (bukan proxy) yang punya kunci SkyP lewat baca biasa tapi tidak lewat rawget
    head("KUNCI SKYP HANYA LEWAT BACA BIASA")
    local n2 = 0
    for i, v in ipairs(gc) do
        if i % 3000 == 0 then task.wait() end
        if type(v) == "table" and n2 < 10 then
            pcall(function()
                if rawget(v, "state") == nil and rawget(v, "addGems") == nil and rawget(v, "fg") == nil then
                    local okS, s = pcall(function() return v.state end)
                    local okG, g = pcall(function() return v.addGems end)
                    local okF, f = pcall(function() return v.fg end)
                    if (okS and type(s) == "function") or (okG and type(g) == "function") or (okF and type(f) == "table") then
                        n2 = n2 + 1
                        good(("K%d %s | %s"):format(n2, table.concat(probe(v), ", "), mtDesc(v)))
                    end
                end
            end)
        end
    end
    if n2 == 0 then log("tidak ada") end
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
