---------------------------------------------------------------------
-- 3) REFERENSI GAME: dicari ulang dari memori
---------------------------------------------------------------------
add("")
add("-- Referensi game --")
do
    local base
    pcall(function()
        local path = FOLDER .. "/debug_sidikjari.json"
        if isfile(path) then
            base = Http:JSONDecode(readfile(path))
        end
    end)
    if type(base) == "table" and type(base.refs) == "table" then
        add(("Pembanding: sidik jari tersimpan (versi game %s, %s)"):format(tostring(base.ver or "?"), os.date("%d/%m %H:%M", base.at or 0)))
    else
        base = { refs = Dbg.Builtin }
        add("Pembanding: ciri bawaan SkyP (belum ada sidik jari tersimpan)")
    end
    local want, order, skipped = {}, {}, {}
    for name, b in pairs(base.refs) do
        if type(b) == "table" and ((b.kind == "table" and #(b.keys or {}) > 0) or (b.kind == "function" and #(b.consts or {}) > 0)) then
            want[name] = b
            order[#order + 1] = name
        else
            skipped[#skipped + 1] = name
        end
    end
    table.sort(order)
    table.sort(skipped)
    local cand, err = Dbg.candidates(want)
    if err then
        add("  " .. err)
    else
        local nOk, nChg, nGone = 0, 0, 0
        local at = #L + 1
        for _, name in ipairs(order) do
            local b, c = want[name], (cand[name] or {})[1]
            if not c then
                nGone = nGone + 1
                add("[HILANG]  " .. name .. ": tidak ada objek game yang mirip ciri lama")
                add("    ciri lama: " .. Dbg.join(b.kind == "table" and b.keys or b.consts, 25))
            elseif c.hit >= c.total then
                nOk = nOk + 1
                add("[ADA]     " .. name .. ": ciri lama masih lengkap")
            else
                nChg = nChg + 1
                local e = Dbg.entry(c.v) or {}
                local now = b.kind == "table" and e.keys or e.consts
                local gone = Dbg.diff(b.kind == "table" and b.keys or b.consts, now)
                add(("[BERUBAH] %s: paling mirip cocok %d dari %d"):format(name, c.hit, c.total))
                add("    ciri lama yang hilang: " .. Dbg.join(gone, 20))
                add("    yang ada sekarang    : " .. Dbg.join(now or {}, 40))
                if b.kind == "function" then
                    add(("    fungsi di baris %s, %s parameter"):format(tostring(e.line), tostring(e.np)))
                end
            end
        end
        table.insert(L, at, ("Hasil: %d masih ada, %d berubah, %d hilang"):format(nOk, nChg, nGone))
        if #skipped > 0 then
            add("Tidak dicek dari sini (hanya bisa dicek dari dalam SkyP): " .. table.concat(skipped, ", "))
        end
    end
end
flush(false)

---------------------------------------------------------------------
-- 4) UJI FILE SKYP
---------------------------------------------------------------------
add("")
add("-- Uji file SkyP --")
do
    local src
    if SCRIPT_FILE == "" then
        add("dilewati (SCRIPT_FILE kosong)")
    elseif not (readfile and isfile) then
        add("dilewati: executor tidak bisa membaca file")
    elseif not isfile(SCRIPT_FILE) then
        add("file '" .. SCRIPT_FILE .. "' tidak ada di folder workspace executor. Taruh file SkyP di sana, atau ganti SCRIPT_FILE di baris atas")
    else
        local ok, res = pcall(readfile, SCRIPT_FILE)
        if ok and type(res) == "string" then
            src = res
        else
            add("gagal membaca file: " .. tostring(res))
        end
    end
    if src then
        add(("ukuran file: %d karakter"):format(#src))
        if not loadstring then
            add("executor tidak punya loadstring: uji kompilasi tidak bisa")
        else
            local fn, cerr = loadstring(src, "=SkyP")
            if not fn then
                add("KOMPILASI GAGAL (script tidak akan jalan sama sekali). Pesan:")
                add("  " .. tostring(cerr))
                add("  angka di antara tanda ':' adalah nomor baris yang salah")
            else
                add("kompilasi: OK")
                if RUN_SCRIPT then
                    flush(false) -- simpan dulu, jaga-jaga kalau SkyP membuat macet
                    add("menjalankan SkyP untuk menangkap error...")
                    local ok, rerr = xpcall(fn, function(e)
                        return debug.traceback(tostring(e), 2)
                    end)
                    if ok then
                        add("SkyP mulai tanpa error di bagian awal. Kalau menunya tetap tidak muncul, cek pesan merah di console (F9)")
                    else
                        add("ERROR SAAT DIJALANKAN:")
                        add("  " .. tostring(rerr))
                    end
                end
            end
        end
    end
end
flush(true)
