local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 400 then table.remove(buf, 1) end -- layar dibatasi, clipboard tetap lengkap
    lbl.Text = table.concat(buf, "\n")
end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end

-- semua kunci tabel (bukan cuma 14), urut, dengan tipe & nilai pendek
local function keysOf(t, max)
    max = max or 45
    local list, n = {}, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "string" then
                local tv = type(v)
                local s = k .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 20) end
                list[#list + 1] = s
            end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci) "):format(n) .. table.concat(list, ", ") .. extra
end

local function has(t, k, ty)
    local ok, v = pcall(function() return t[k] end)
    return ok and type(v) == ty
end

local function main()
    if not getloadedmodules then bad("executor tidak punya getloadedmodules"); return end
    local mods = getloadedmodules()
    local reqd = {} -- { path, value }
    for _, mod in ipairs(mods) do
        local okp, path = pcall(function() return mod:GetFullName() end)
        path = okp and path or tostring(mod)
        if not path:find("CoreGui", 1, true) and not path:find("RobloxGui", 1, true)
            and not path:find("PlayerModule", 1, true) then
            local ok, m = pcall(require, mod)
            if ok then reqd[#reqd + 1] = { path, m } end
        end
    end
    log(#reqd .. " modul bisa di-require")

    -- 1) NET & ROLES: cek fungsi yang dipakai SkyP satu per satu
    head("NET / ROLES / INVENTORI (modul)")
    local InvMod
    for _, r in ipairs(reqd) do
        local m = r[2]
        if type(m) == "table" then
            if has(m, "act", "table") and has(m, "treeChanged", "table") then
                log("NET " .. r[1] .. ": call=" .. tostring(has(m, "call", "function")) .. " tile=" .. tostring(has(m, "tile", "table"))
                    .. " on=" .. tostring(has(m, "on", "function")))
            end
            if has(m, "isDeveloper", "function") then
                log("ROLES " .. r[1] .. ": titlesOf=" .. tostring(has(m, "titlesOf", "function"))
                    .. " isModerator=" .. tostring(has(m, "isModerator", "function"))
                    .. " isUndercover=" .. tostring(has(m, "isUndercover", "function")))
            end
            if has(m, "room", "function") and has(m, "used", "function") and has(m, "count", "function") and has(m, "new", "function") then
                InvMod = m
                good("INVENTORI modul: " .. r[1])
            end
        end
    end

    -- 2) ITEMDB: tiap potongan, apakah entrinya punya id/name/kind
    head("ITEMDB (potongan)")
    local total = 0
    for _, r in ipairs(reqd) do
        local m = r[2]
        if type(m) == "table" then
            local n, mn, mx, sample, withName, withId, withKind = 0, nil, nil, nil, 0, 0, 0
            pcall(function()
                for k, v in pairs(m) do
                    if type(k) == "number" and type(v) == "table" then
                        n = n + 1
                        if not mn or k < mn then mn = k end
                        if not mx or k > mx then mx = k end
                        if type(rawget(v, "name")) == "string" then withName = withName + 1 end
                        if type(rawget(v, "id")) == "number" then withId = withId + 1 end
                        if rawget(v, "kind") ~= nil then withKind = withKind + 1 end
                        if not sample then sample = { k, v } end
                    end
                end
            end)
            if n >= 30 then
                local line = ("%s | n=%d kunci %s..%s | name=%d id=%d kind=%d"):format(r[1], n, tostring(mn), tostring(mx), withName, withId, withKind)
                if withName > 0 then good(line); total = total + withName else log(line) end
                if sample and withName > 0 then
                    log("   contoh [" .. tostring(sample[1]) .. "]: " .. keysOf(sample[2], 25))
                end
            end
        end
    end
    log("total entri bernama: " .. total)

    if not getgc then bad("executor tidak punya getgc: bagian World/Inventori/Posisi dilewati"); return end
    local okG, gc = pcall(getgc, true)
    if not okG or type(gc) ~= "table" then bad("getgc(true) gagal: " .. tostring(gc)); return end
    log("getgc: " .. #gc .. " objek")

    local worlds, exact, invs, invMeta, states, others, drops = {}, 0, {}, {}, {}, {}, {}
    for i, v in ipairs(gc) do
        if i % 4000 == 0 then task.wait() end
        if type(v) == "table" then
            pcall(function()
                local w, h = rawget(v, "w"), rawget(v, "h")
                if type(w) == "number" and type(h) == "number" and w >= 20 and h >= 20 and w <= 5000 and h <= 5000 then
                    if #worlds < 8 then worlds[#worlds + 1] = v end
                    if type(rawget(v, "fg")) == "table" and type(rawget(v, "bg")) == "table" and rawget(v, "spawn") ~= nil then
                        exact = exact + 1
                    end
                end
                if InvMod and getmetatable(v) == InvMod and #invMeta < 3 then invMeta[#invMeta + 1] = v end
                if type(rawget(v, "slots")) == "table" and #invs < 5 then invs[#invs + 1] = v end
                if type(rawget(v, "state")) == "function" and #states < 4 then states[#states + 1] = v end
                if type(rawget(v, "playerAt")) == "function" and #others < 3 then others[#others + 1] = v end
                local e = rawget(v, 1)
                if type(e) == "table" and rawget(e, "uid") ~= nil and #drops < 2 then drops[#drops + 1] = v end
            end)
        end
    end

    -- 3) WORLD
    head("WORLD")
    if exact > 0 then good("cocok pola SkyP (fg,bg,w,h,spawn): " .. exact) else bad("TIDAK ada yang cocok pola SkyP (fg,bg,w,h,spawn)") end
    log("kandidat (punya w & h angka): " .. #worlds)
    for i, v in ipairs(worlds) do
        log(("W%d %s"):format(i, keysOf(v, 60)))
        -- cari tabel baris tile di dalamnya (bentuk [y][x] atau datar)
        pcall(function()
            for k, sub in pairs(v) do
                if type(sub) == "table" then
                    local r0 = rawget(sub, 0) or rawget(sub, 1)
                    if type(r0) == "table" then
                        local _, x0 = next(r0)
                        log(("   %s: baris[0/1] = tabel (isi pertama %s)"):format(tostring(k), tostring(x0)))
                    elseif type(r0) == "number" then
                        log(("   %s: tabel datar angka (contoh %s)"):format(tostring(k), tostring(r0)))
                    elseif type(r0) == "string" or type(r0) == "buffer" then
                        log(("   %s: %s (panjang %s)"):format(tostring(k), type(r0), tostring(#tostring(r0))))
                    end
                elseif typeof and typeof(sub) == "buffer" then
                    log(("   %s: BUFFER (buffer.len=%s)"):format(tostring(k), tostring(pcall(buffer.len, sub) and buffer.len(sub))))
                end
            end
        end)
    end

    -- 4) INVENTORI
    head("INVENTORI (tas)")
    log("instance dengan metatable modul inventori: " .. #invMeta)
    for i, v in ipairs(invMeta) do log(("I%d %s"):format(i, keysOf(v, 30))) end
    log("tabel punya 'slots': " .. #invs)
    for i, v in ipairs(invs) do
        log(("S%d %s"):format(i, keysOf(v, 30)))
        pcall(function()
            local k, s = next(v.slots)
            log("   slot pertama [" .. tostring(k) .. "] = " .. (type(s) == "table" and keysOf(s, 10) or tostring(s)))
        end)
    end

    -- 5) POSISI KARAKTER
    head("POSISI (fungsi state)")
    log("kandidat: " .. #states)
    for i, v in ipairs(states) do
        local ok, s = pcall(rawget(v, "state"))
        log(("P%d %s"):format(i, ok and type(s) == "table" and keysOf(s, 25) or ("hasil: " .. tostring(s))))
    end

    -- 6) PEMAIN LAIN & DROP
    head("PEMAIN LAIN / DROP")
    log("kandidat pemain (playerAt): " .. #others)
    for i, v in ipairs(others) do log(("O%d %s"):format(i, keysOf(v, 25))) end
    log("kandidat daftar drop (uid): " .. #drops)
    for i, v in ipairs(drops) do log(("D%d isi pertama: %s"):format(i, keysOf(v[1], 25))) end

    -- 7) GUI world (nama wadah tile)
    head("GUI")
    local pg = lp:FindFirstChild("PlayerGui")
    if pg then
        local names = {}
        for _, c in ipairs(pg:GetChildren()) do names[#names + 1] = c.Name end
        log("PlayerGui: " .. table.concat(names, ", "))
        local gg = pg:FindFirstChild("GameGui")
        log("GameGui: " .. (gg and "ADA" or "TIDAK ADA"))
    end
    local rs = game:GetService("ReplicatedStorage")
    local wr = rs:FindFirstChild("WorldRemotes")
    log("WorldRemotes: " .. (wr and (#wr:GetChildren() .. " anak") or "TIDAK ADA"))
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
if setclipboard then pcall(setclipboard, table.concat(plain, "\n")) end
