local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 300 then table.remove(buf, 1) end
end
local function flush() lbl.Text = table.concat(buf, "\n") end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end







local getconsts = (debug and debug.getconstants) or getconstants
local getup = (debug and debug.getupvalue) or getupvalue
local getups = (debug and debug.getupvalues) or getupvalues
local RunService = game:GetService("RunService")

local function ups(f)
    if getups then
        local ok, t = pcall(getups, f)
        if ok and type(t) == "table" then return t end
    end
    local out = {}
    if getup then
        for i = 1, 80 do
            local ok, v = pcall(getup, f, i)
            if not ok then break end
            out[i] = v
        end
    end
    return out
end

-- kata yang biasanya ada di fungsi pukul / break
local KEYS = { "vending", "empty", "crack", "punch", "harvest", "hit", "break", "lock", "can't", "cannot", "only", "tile", "act", "hits" }
local STRONG = { ["Empty the Vending Machine first!"] = 10, newCrack = 6, HarvestProvider = 6 }

local function isGame(f)
    if isexecutorclosure then
        local ok, r = pcall(isexecutorclosure, f)
        if ok and r then return false end
    end
    if iscclosure then
        local ok, r = pcall(iscclosure, f)
        if ok and r then return false end
    end
    local ok, src = pcall(debug.info, f, "s")
    if ok and type(src) == "string" and (src:find("CoreGui", 1, true) or src:find("CorePackages", 1, true)
        or src:find("PlayerModule", 1, true)) then return false end
    return true
end

local function score(f)
    local ok, consts = pcall(getconsts, f)
    if not ok or type(consts) ~= "table" then return 0, nil end
    local sc, strs = 0, {}
    for _, c in pairs(consts) do
        if type(c) == "string" then
            strs[#strs + 1] = c
            if STRONG[c] then sc = sc + STRONG[c] end
            local lc = c:lower()
            for _, k in ipairs(KEYS) do
                if lc:find(k, 1, true) then sc = sc + 1 break end
            end
        end
    end
    return sc, strs
end

local function main()
    if not getconsts then bad("executor tidak punya getconstants") return end
    -- kumpulkan fungsi: dari getgc + telusur dari loop game
    local funcs, seen = {}, {}
    local function add(f) if not seen[f] then seen[f] = true funcs[#funcs + 1] = f end end
    local okG, gc = pcall(getgc, false)
    if okG then for _, f in ipairs(gc) do if type(f) == "function" then add(f) end end end
    log("fungsi dari getgc: " .. #funcs)
    if getconnections then
        local queue, qi, vis = {}, 1, {}
        for _, name in ipairs({ "RenderStepped", "Heartbeat", "Stepped", "PreRender" }) do
            local okS, sig = pcall(function() return RunService[name] end)
            local ok, conns = pcall(getconnections, sig)
            if okS and ok and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    local okf, fn = pcall(function() return c.Function end)
                    if okf and type(fn) == "function" then queue[#queue + 1] = fn vis[fn] = true end
                end
            end
        end
        local nodes = 0
        while qi <= #queue and nodes < 40000 do
            local x = queue[qi]; qi = qi + 1; nodes = nodes + 1
            if nodes % 1500 == 0 then title.Text = ("SkyP Debug 14: telusur %d"):format(nodes) task.wait() end
            if type(x) == "function" then
                add(x)
                for _, u in pairs(ups(x)) do
                    if (type(u) == "table" or type(u) == "function") and not vis[u] then vis[u] = true queue[#queue + 1] = u end
                end
            elseif type(x) == "table" then
                pcall(function()
                    local n = 0
                    for _, v in next, x do
                        n = n + 1
                        if n > 600 then break end
                        if (type(v) == "table" or type(v) == "function") and not vis[v] then vis[v] = true queue[#queue + 1] = v end
                    end
                end)
            end
        end
    end
    log("total fungsi diperiksa: " .. #funcs)

    local cands = {}
    for i, f in ipairs(funcs) do
        if i % 1500 == 0 then title.Text = ("SkyP Debug 14: periksa %d%%"):format(math.floor(i / #funcs * 100)) task.wait() end
        if isGame(f) then
            local sc, strs = score(f)
            if sc >= 3 then cands[#cands + 1] = { f, sc, strs } end
        end
    end
    table.sort(cands, function(a, b) return a[2] > b[2] end)
    title.Text = "SkyP Debug 14 (selesai)"

    head("CALON FUNGSI PUKUL (skor tertinggi dulu)")
    if #cands == 0 then bad("tidak ada") end
    for i = 1, math.min(12, #cands) do
        local f, sc, strs = cands[i][1], cands[i][2], cands[i][3]
        local okN, nm = pcall(debug.info, f, "n")
        local okA, na, va = pcall(debug.info, f, "a")
        local okS, src = pcall(debug.info, f, "s")
        local okL, line = pcall(debug.info, f, "l")
        good(("C%d skor %d | '%s' param=%s%s | %s:%s"):format(i, sc, tostring(okN and nm or "?"),
            tostring(okA and na or "?"), (okA and va) and "+..." or "", tostring(okS and src or "?"):sub(-40), tostring(okL and line or "?")))
        local shown = {}
        for j = 1, math.min(30, #strs) do shown[j] = strs[j]:sub(1, 40) end
        log("   teks: " .. table.concat(shown, " | "))
    end
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
flush()
if setclipboard then pcall(setclipboard, table.concat(plain, "\n")) end
