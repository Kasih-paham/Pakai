local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 400 then table.remove(buf, 1) end
    lbl.Text = table.concat(buf, "\n")
end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end


local getmt = getrawmetatable or getmetatable

local function keysOf(t, max)
    max = max or 60
    local list, n, nnum = {}, 0, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "number" then nnum = nnum + 1
            else
                local tv = typeof(v)
                local s = tostring(k) .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 20) end
                list[#list + 1] = s
            end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci, %d angka) "):format(n, nnum) .. table.concat(list, ", ") .. extra
end

local function isGrid(t)
    local rows, cols = 0, 0
    pcall(function()
        for k, row in next, t do
            if type(k) ~= "number" or type(row) ~= "table" then rows = -999 return end
            rows = rows + 1
            if rows == 1 then for _ in next, row do cols = cols + 1 if cols > 300 then break end end end
            if rows > 2000 then break end
        end
    end)
    return rows >= 30 and cols >= 30
end

local function main()
    local InvMod
    for _, mod in ipairs(getloadedmodules()) do
        local ok, m = pcall(require, mod)
        if ok and type(m) == "table" then
            local ok2, yes = pcall(function()
                return type(m.room) == "function" and type(m.used) == "function" and type(m.count) == "function" and type(m.new) == "function"
            end)
            if ok2 and yes then InvMod = m break end
        end
    end

    local gc = getgc(true)
    log("getgc: " .. #gc .. " objek")
    local C = { world = 0, worldNear = {}, inv = 0, state = 0, menu = 0, gems = 0, hud = 0, others = 0, gridOwner = {} }
    local grids = {}
    for i, v in ipairs(gc) do
        if i % 3000 == 0 then task.wait() end
        if type(v) == "table" then
            pcall(function()
                local fg, bg = rawget(v, "fg"), rawget(v, "bg")
                local w, h, sp = rawget(v, "w"), rawget(v, "h"), rawget(v, "spawn")
                local score = (type(fg) == "table" and 1 or 0) + (type(bg) == "table" and 1 or 0)
                    + (type(w) == "number" and 1 or 0) + (type(h) == "number" and 1 or 0) + (sp ~= nil and 1 or 0)
                if score == 5 then
                    C.world = C.world + 1
                    if C.world == 1 then C.worldTab = v end
                elseif score >= 2 and #C.worldNear < 4 then
                    C.worldNear[#C.worldNear + 1] = ("fg=%s bg=%s w=%s h=%s spawn=%s"):format(type(fg), type(bg), type(w), type(h), typeof(sp))
                end
                if InvMod and getmt(v) == InvMod and type(rawget(v, "slots")) == "table" and rawget(v, "capacity") ~= nil then C.inv = C.inv + 1 end
                local st = rawget(v, "state")
                if type(st) == "function" then
                    local ok, s = pcall(st)
                    if ok and type(s) == "table" and type(s.x) == "number" and s.facing ~= nil and s.vx ~= nil then C.state = C.state + 1 end
                end
                if type(rawget(v, "openBackpack")) == "function" and type(rawget(v, "ui")) == "table" then C.menu = C.menu + 1 end
                if type(rawget(v, "addGems")) == "function" then C.gems = C.gems + 1 end
                if type(rawget(v, "punchRange")) == "function" and type(rawget(v, "handPower")) == "function" then C.hud = C.hud + 1 end
                if type(rawget(v, "list")) == "function" and type(rawget(v, "where")) == "function" and type(rawget(v, "playerAt")) == "function" then C.others = C.others + 1 end
                if #grids < 6 and isGrid(v) then grids[#grids + 1] = v end
            end)
        end
    end

    head("ATURAN PEMINDAI SKYP (findRefs)")
    local function row(name, n) if n > 0 then good(name .. ": OK (" .. n .. ")") else bad(name .. ": TIDAK") end end
    row("World (fg, bg, w, h, spawn)", C.world)
    for _, s in ipairs(C.worldNear) do log("   hampir cocok: " .. s) end
    row("Inventori (metatable modul + slots + capacity)", C.inv)
    row("Posisi (state() -> x, facing, vx)", C.state)
    row("Menu (openBackpack + ui)", C.menu)
    row("Gems (addGems)", C.gems)
    row("Hud (punchRange + handPower)", C.hud)
    row("Pemain lain (list + where + playerAt)", C.others)

    if C.worldTab then
        head("ISI DATA WORLD")
        local w = C.worldTab
        log("nama: " .. tostring(rawget(w, "name")) .. " | ukuran " .. tostring(rawget(w, "w")) .. "x" .. tostring(rawget(w, "h")))
        for _, k in ipairs({ "takeDrop", "dropList", "dropTaken", "spliceSeed", "tileChanged", "vendCall", "call", "enter", "jammerOn", "raymanOn", "builderOk", "areas", "vends", "vendOwner" }) do
            log(("  %s = %s"):format(k, typeof(rawget(w, k))))
        end
    end

    -- pemilik grid: semua kunci diperiksa
    head("PEMILIK GRID (semua kunci)")
    local want = {}
    for i, g in ipairs(grids) do want[g] = i end
    local hits = 0
    for i, v in ipairs(gc) do
        if i % 3000 == 0 then task.wait() end
        if type(v) == "table" and hits < 8 and not want[v] then
            pcall(function()
                for k, x in next, v do
                    if want[x] then
                        hits = hits + 1
                        good(("G%d dipegang kunci '%s' oleh: %s"):format(want[x], tostring(k), keysOf(v, 30)))
                        break
                    end
                end
            end)
        end
    end
    if hits == 0 then bad("pemilik grid tidak ketemu") end
end

