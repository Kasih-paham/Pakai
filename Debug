local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    lbl.Text = table.concat(buf, "\n")
end

-- Ringkasan isi tabel: jumlah kunci angka + contoh kunci teks (f = fungsi, t = tabel)
local function summarize(m)
    if type(m) ~= "table" then return type(m) end
    local nnum, strs, count = 0, {}, 0
    for k, v in pairs(m) do
        count = count + 1
        if count > 400 then break end
        if type(k) == "number" then nnum = nnum + 1
        elseif type(k) == "string" and #strs < 14 then
            local t = type(v)
            strs[#strs + 1] = k .. (t == "function" and "(f)" or t == "table" and "(t)" or "")
        end
    end
    table.sort(strs)
    return string.format("table num=%d str=[%s]", nnum, table.concat(strs, ","))
end

local function fn(t, k) return type(t[k]) == "function" end

local function classify(m)
    local tags = {}
    if type(m) ~= "table" then return tags end
    local function try(f) local ok, r = pcall(f); return ok and r end
    if try(function() return fn(m, "call") and type(m.act) == "table" and type(m.tile) == "table" end) then tags[#tags + 1] = "NET" end
    if try(function() return fn(m, "titlesOf") and fn(m, "isModerator") end) then tags[#tags + 1] = "ROLES" end
    if try(function() return fn(m, "play") and fn(m, "playAt") end) then tags[#tags + 1] = "SFX" end
    if try(function() return fn(m, "spawn") and not fn(m, "play") end) then tags[#tags + 1] = "PARTICLES?" end
    if try(function() return rawget(m, "isDown") ~= nil end) then tags[#tags + 1] = "WORLDMENU?" end
    if try(function()
        local n, tbl = 0, 0
        for k, v in pairs(m) do
            if type(k) == "number" then n = n + 1; if type(v) == "table" then tbl = tbl + 1 end end
            if n > 60 then break end
        end
        return n > 50 and tbl > 50
    end) then tags[#tags + 1] = "ITEMDB?" end
    if try(function() return rawget(m, "__index") == m end) then tags[#tags + 1] = "CLASS(inventory/particles?)" end
    return tags
end

local function main()
    if not getloadedmodules then log("executor tidak punya getloadedmodules", "#ff6b6b"); return end
    local okL, mods = pcall(getloadedmodules)
    if not okL then log("error: " .. tostring(mods), "#ff6b6b"); return end
    log("== " .. #mods .. " modul dimuat ==", "#6eafff")

    local matches, rows = {}, {}
    for _, mod in ipairs(mods) do
        local okp, path = pcall(function() return mod:GetFullName() end)
        path = okp and path or tostring(mod)
        if not path:find("CoreGui", 1, true) and not path:find("RobloxGui", 1, true)
            and not path:find("PlayerModule", 1, true) then
            local ok, m = pcall(require, mod)
            if ok then
                local tags = classify(m)
                local row = path .. " | " .. summarize(m)
                if #tags > 0 then
                    matches[#matches + 1] = "[" .. table.concat(tags, ",") .. "] " .. row
                else
                    rows[#rows + 1] = row
                end
            end
        end
    end

    log("== COCOK DENGAN SIDIK JARI ==", "#6eafff")
    if #matches == 0 then log("tidak ada yang cocok", "#ff6b6b") end
    for _, r in ipairs(matches) do log(r, "#5be08a") end
    log("== MODUL LAIN (" .. #rows .. ") ==", "#6eafff")
    for _, r in ipairs(rows) do log(r) end

    log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
    if setclipboard then pcall(setclipboard, table.concat(plain, "\n")) end
end

local s, e = pcall(main)
if not s then log("error di debug: " .. tostring(e), "#ff6b6b") end
