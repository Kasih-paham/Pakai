local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 400 then table.remove(buf, 1) end
    lbl.Text = table.concat(buf, "\n")
end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end

local getmt = getrawmetatable or getmetatable
local isBuffer = function(v) return typeof(v) == "buffer" end

-- kunci tabel (raw), urut, dengan tipe & nilai pendek
local function keysOf(t, max)
    max = max or 45
    local list, n, nnum = {}, 0, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "number" then
                nnum = nnum + 1
            else
                local tv = typeof(v)
                local s = tostring(k) .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 20)
                elseif tv == "buffer" then s = s .. "(" .. buffer.len(v) .. ")" end
                list[#list + 1] = s
            end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci, %d angka) "):format(n, nnum) .. table.concat(list, ", ") .. extra
end

local function mtInfo(v)
    local ok, mt = pcall(getmt, v)
    if not ok or type(mt) ~= "table" then return "" end
    local idx = rawget(mt, "__index")
    return " | metatable: __index=" .. typeof(idx) .. (rawget(mt, "__newindex") and ", __newindex" or "")
        .. (type(idx) == "table" and (" -> " .. keysOf(idx, 20)) or "")
end

-- grid 2D: >= 30 baris (tabel) yang isinya >= 30 angka
local function gridInfo(t)
    local rows, cols, nums = 0, 0, 0
    local ok = pcall(function()
        for k, row in next, t do
            if type(k) ~= "number" or type(row) ~= "table" then return end
            rows = rows + 1
            if rows == 1 then
                for _, x in next, row do
                    cols = cols + 1
                    if type(x) == "number" then nums = nums + 1 end
                    if cols > 300 then break end
                end
            end
            if rows > 2000 then break end
        end
    end)
    if ok and rows >= 30 and cols >= 30 and nums >= cols * 0.8 then return rows, cols end
    return nil
end

-- array datar angka besar (w*h)
local function flatInfo(t)
    local n = 0
    local ok = pcall(function()
        for k, v in next, t do
            if type(k) ~= "number" or type(v) ~= "number" then n = -1 return end
            n = n + 1
            if n > 20000 then break end
        end
    end)
    if ok and n >= 3000 then return n end
    return nil
end

local function main()
    -- modul inventori
    local InvMod
    if getloadedmodules then
        for _, mod in ipairs(getloadedmodules()) do
            local ok, m = pcall(require, mod)
            if ok and type(m) == "table" then
                local ok2, yes = pcall(function()
                    return type(m.room) == "function" and type(m.used) == "function" and type(m.count) == "function" and type(m.new) == "function"
                end)
                if ok2 and yes then InvMod = m break end
            end
        end
    end
    log("modul inventori: " .. (InvMod and "ada" or "TIDAK ADA"))

    local okG, gc = pcall(getgc, true)
    if not okG or type(gc) ~= "table" then bad("getgc gagal") return end
    log("getgc: " .. #gc .. " objek")

    local grids, flats, bufs, invInst, posTabs, proxied = {}, {}, {}, {}, {}, 0
    local mtIdx = {} -- metatable.__index berbeda yang sering dipakai
    for i, v in ipairs(gc) do
        if i % 3000 == 0 then task.wait() end
        if type(v) == "table" then
            -- tas
            if InvMod then
                local ok, mt = pcall(getmt, v)
                if ok and mt ~= nil and (mt == InvMod or (type(mt) == "table" and rawget(mt, "__index") == InvMod)) then
                    if #invInst < 3 then invInst[#invInst + 1] = v end
                end
            end
            -- proxy (metatable dengan __index tabel)
            local okM, mt = pcall(getmt, v)
            if okM and type(mt) == "table" and type(rawget(mt, "__index")) == "table" and rawget(mt, "__index") ~= mt then
                proxied = proxied + 1
            end
            -- grid / array datar
            if #grids < 6 then
                local r, c = gridInfo(v)
                if r then grids[#grids + 1] = { v, r, c } end
            end
            if #flats < 6 then
                local n = flatInfo(v)
                if n then flats[#flats + 1] = { v, n } end
            end
            -- posisi: tabel dengan x, y angka + facing / vx
            pcall(function()
                if #posTabs < 6 and type(rawget(v, "x")) == "number" and type(rawget(v, "y")) == "number"
                    and (rawget(v, "facing") ~= nil or rawget(v, "vx") ~= nil or rawget(v, "grounded") ~= nil) then
                    posTabs[#posTabs + 1] = v
                end
            end)
            -- buffer besar di dalam tabel
            if #bufs < 8 then
                pcall(function()
                    local n = 0
                    for k, x in next, v do
                        n = n + 1
                        if n > 80 then break end
                        if isBuffer(x) and buffer.len(x) >= 2000 then
                            bufs[#bufs + 1] = { v, k, buffer.len(x) }
                            break
                        end
                    end
                end)
            end
        end
    end

    head("TAS (instance modul inventori)")
    log("ditemukan: " .. #invInst)
    for i, v in ipairs(invInst) do log(("I%d %s"):format(i, keysOf(v, 30))) end

    head("POSISI (x, y + facing/vx/grounded)")
    log("ditemukan: " .. #posTabs)
    for i, v in ipairs(posTabs) do log(("P%d %s"):format(i, keysOf(v, 30))) end

    head("GRID TILE 2D")
    log("ditemukan: " .. #grids)
    head("ARRAY DATAR (>= 3000 angka)")
    for i, f in ipairs(flats) do log(("F%d n=%d"):format(i, f[2])) end
    head("BUFFER BESAR")
    for i, b in ipairs(bufs) do log(("B%d kunci %s, %d byte | pemilik %s"):format(i, tostring(b[2]), b[3], keysOf(b[1], 40))) end
    log("tabel ber-proxy (metatable __index tabel): " .. proxied)

    -- siapa yang memegang grid / array datar (pemilik = calon data world)
    head("PEMILIK GRID / ARRAY (calon data world)")
    local want = {}
    for _, g in ipairs(grids) do want[g[1]] = ("grid %dx%d"):format(g[2], g[3]) end
    for _, f in ipairs(flats) do want[f[1]] = ("datar n=%d"):format(f[2]) end
    if next(want) == nil then bad("tidak ada grid / array untuk dicari pemiliknya") end
    local found = 0
    if next(want) then
        for i, v in ipairs(gc) do
            if i % 3000 == 0 then task.wait() end
            if type(v) == "table" and found < 8 then
                pcall(function()
                    local n = 0
                    for k, x in next, v do
                        n = n + 1
                        if n > 120 then break end
                        if want[x] then
                            found = found + 1
                            good(("W%d kunci '%s' -> %s"):format(found, tostring(k), want[x]))
                            log("   pemilik: " .. keysOf(v, 60) .. mtInfo(v))
                            break
                        end
                    end
                end)
            end
        end
    end
    if found == 0 and next(want) then bad("pemilik tidak ketemu (dipegang upvalue fungsi saja?)") end

    -- grid juga bisa dipegang langsung oleh upvalue fungsi
    head("UPVALUE YANG MEMEGANG GRID / BUFFER")
    local gu = debug and (debug.getupvalues or debug.getupvalue)
    if gu and next(want) then
        local hits = 0
        for i, f in ipairs(gc) do
            if i % 3000 == 0 then task.wait() end
            if type(f) == "function" and hits < 6 then
                local ok, ups = pcall(debug.getupvalues or function() return {} end, f)
                if ok and type(ups) == "table" then
                    for idx, u in pairs(ups) do
                        if want[u] then
                            hits = hits + 1
                            local okS, src = pcall(debug.info, f, "s")
                            local okN, nm = pcall(debug.info, f, "n")
                            good(("U%d upvalue #%s = %s | fungsi '%s' di %s"):format(hits, tostring(idx), want[u],
                                tostring(okN and nm or "?"), tostring(okS and src or "?")))
                            -- upvalue lain di fungsi itu (bisa w, h, data world lain)
                            local parts = {}
                            for j, x in pairs(ups) do
                                local tx = typeof(x)
                                parts[#parts + 1] = j .. ":" .. tx .. ((tx == "number" or tx == "string" or tx == "boolean") and ("=" .. tostring(x):sub(1, 16)) or "")
                            end
                            log("   upvalue lain: " .. table.concat(parts, ", "))
                            break
                        end
                    end
                end
            end
        end
        if hits == 0 then bad("tidak ada upvalue yang memegangnya") end
    end
end

