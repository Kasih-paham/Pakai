local buf, plain = {}, {}
local function log(msg, color)
    msg = tostring(msg)
    plain[#plain + 1] = msg
    local safe = msg:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    buf[#buf + 1] = color and string.format('<font color="%s">%s</font>', color, safe) or safe
    if #buf > 300 then table.remove(buf, 1) end
end
local function flush() lbl.Text = table.concat(buf, "\n") end
local function head(t) log("== " .. t .. " ==", "#6eafff") end
local function bad(t) log(t, "#ff6b6b") end
local function good(t) log(t, "#5be08a") end




local getmt = getrawmetatable or getmetatable

local function rawKeys(t, max)
    max = max or 50
    local list, n, nnum = {}, 0, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if type(k) == "number" then nnum = nnum + 1
            else
                local tv = typeof(v)
                local s = tostring(k) .. ":" .. (tv == "function" and "f" or tv == "table" and "t" or tv)
                if tv == "number" or tv == "boolean" then s = s .. "=" .. tostring(v)
                elseif tv == "string" then s = s .. "=" .. string.sub(v, 1, 18) end
                list[#list + 1] = s
            end
            if n > 400 then break end
        end
    end)
    table.sort(list)
    local extra = #list > max and (" ...+" .. (#list - max)) or ""
    while #list > max do table.remove(list) end
    return ("(%d kunci, %d angka) "):format(n, nnum) .. table.concat(list, ", ") .. extra
end

-- kunci khas SkyP (tidak ada di tabel global Roblox / executor)
local PROBE = { fg = "table", bg = "table", state = "function", addGems = "function", punchRange = "function",
    handPower = "function", openBackpack = "function", playerAt = "function", takeDrop = "function",
    dropList = "function", spliceSeed = "function", tileChanged = "function", vendCall = "function", jammerOn = "function" }

local function isGlobalEnv(t, idx)
    if rawget(t, "script") ~= nil or rawget(t, "_G") ~= nil then return true end
    if type(idx) == "table" and (rawget(idx, "game") ~= nil or rawget(idx, "Instance") ~= nil
        or rawget(idx, "getgenv") ~= nil or rawget(idx, "AdReward") ~= nil or rawget(idx, "DELTA_VERSION_NUM") ~= nil) then
        return true
    end
    return false
end

local function main()
    title.Text = "SkyP Debug 11: memindai..."
    local gc = getgc(true)
    log("getgc: " .. #gc .. " objek")
    local worlds, hits = {}, {}
    for i, v in ipairs(gc) do
        if i % 2000 == 0 then
            title.Text = ("SkyP Debug 11: %d%%"):format(math.floor(i / #gc * 100))
            task.wait()
        end
        if type(v) == "table" then
            pcall(function()
                if #worlds < 4 and type(rawget(v, "w")) == "number" and type(rawget(v, "h")) == "number" then
                    worlds[#worlds + 1] = v
                end
                if #hits >= 12 then return end
                local mt = getmt(v)
                if type(mt) ~= "table" then return end
                local idx = rawget(mt, "__index")
                if type(idx) ~= "table" or idx == mt or isGlobalEnv(v, idx) then return end
                -- hanya __index berupa TABEL: baca kunci dari tabel itu (tanpa memanggil fungsi apa pun)
                local found = {}
                for k, ty in pairs(PROBE) do
                    if rawget(v, k) == nil and type(rawget(idx, k)) == ty then found[#found + 1] = k end
                end
                if #found > 0 then hits[#hits + 1] = { v, idx, found } end
            end)
        end
    end
    title.Text = "SkyP Debug 11 (selesai)"

    head("TABEL W/H (calon world)")
    if #worlds == 0 then bad("tidak ada") end
    for i, v in ipairs(worlds) do
        log(("W%d %s"):format(i, rawKeys(v, 80)))
        local ok, mt = pcall(getmt, v)
        if ok and type(mt) == "table" then
            local idx = rawget(mt, "__index")
            log("   metatable __index=" .. typeof(idx) .. (type(idx) == "table" and (" -> " .. rawKeys(idx, 40)) or ""))
        else
            log("   tanpa metatable")
        end
        pcall(function()
            local n = 0
            for k, sub in next, v do
                if type(sub) == "table" and n < 12 then
                    n = n + 1
                    local r0 = rawget(sub, 0) or rawget(sub, 1)
                    local c = 0
                    for _ in next, sub do c = c + 1 if c > 5000 then break end end
                    log(("   [%s] tabel n=%d isi[0/1]=%s"):format(tostring(k), c, typeof(r0)))
                end
            end
        end)
    end

    head("PROXY DENGAN KUNCI KHAS SKYP")
    if #hits == 0 then bad("tidak ada") end
    for i, h in ipairs(hits) do
        good(("X%d kunci: %s"):format(i, table.concat(h[3], ", ")))
        log("   raw: " .. rawKeys(h[1], 25))
        log("   __index: " .. rawKeys(h[2], 40))
    end
end

local s, e = pcall(main)
if not s then bad("error di debug: " .. tostring(e)) end
log("selesai. Log disalin ke clipboard: TEMPEL ke chat Claude.", "#6eafff")
flush()
if setclipboard then pcall(setclipboard, table.concat(plain, "\n")) end
