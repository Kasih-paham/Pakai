-- =====================================================================
-- SkyP DEBUG (berdiri sendiri)
-- Dipakai kalau SkyP TIDAK BISA di-execute sama sekali, jadi tab Observasi tidak bisa dibuka.
-- Execute file ini SENDIRI (tanpa SkyP), di dalam world. Yang dikerjakan:
--   1. cek executor & fungsi yang dibutuhkan SkyP
--   2. cek objek game yang dicari SkyP saat mulai
--   3. cari ulang semua referensi game dari memori, dibandingkan dengan sidik jari terakhir
--      yang tersimpan (kalau belum ada: ciri bawaan SkyP)
--   4. uji file SkyP: bisa dikompilasi atau tidak, dan error apa saat dijalankan (dengan nomor baris)
-- Laporan: muncul di console (F9), disalin ke clipboard, dan disimpan ke file LAPORAN di bawah.
-- =====================================================================
local SCRIPT_FILE = "SkyP.lua"  -- nama file SkyP di folder workspace executor ("" = lewati uji file)
local RUN_SCRIPT = true         -- true = setelah lolos kompilasi, SkyP ikut dijalankan untuk menangkap error-nya
local FOLDER = "Alfian"         -- folder config SkyP
local LAPORAN = FOLDER .. "/debug_laporan.txt"

local L = {}
local function add(x)
    L[#L + 1] = tostring(x)
    print("[SkyP Debug] " .. tostring(x))
end
local function yn(v)
    return v and "ada" or "TIDAK ADA"
end
local getconsts = (debug and debug.getconstants) or getconstants
local Http = game:GetService("HttpService")

local function isGameFn(fn)
    if isexecutorclosure then
        local ok, res = pcall(isexecutorclosure, fn)
        if ok and res then
            return false
        end
    end
    if islclosure then
        local ok, res = pcall(islclosure, fn)
        if ok and not res then
            return false
        end
    end
    local ok, src = pcall(debug.info, fn, "s")
    if ok and type(src) == "string" and (string.find(src, "CoreGui", 1, true) or string.find(src, "CorePackages", 1, true)) then
        return false
    end
    return true
end

local function childNames(inst, max)
    local out = {}
    pcall(function()
        for i, c in ipairs(inst:GetChildren()) do
            if i > max then
                out[#out + 1] = "...+" .. (#inst:GetChildren() - max)
                break
            end
            out[#out + 1] = c.Name .. "(" .. c.ClassName .. ")"
        end
    end)
    return #out > 0 and table.concat(out, ", ") or "-"
end

local function flush(done)
    local text = table.concat(L, "\n")
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder(FOLDER) then
            makefolder(FOLDER)
        end
        writefile(LAPORAN, text)
    end)
    if done then
        local clip = setclipboard or toclipboard
        if clip then
            pcall(clip, text)
        end
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "SkyP Debug",
                Text = "Selesai. Laporan disalin ke clipboard dan disimpan di " .. LAPORAN,
                Duration = 10,
            })
        end)
    end
end

local Dbg = {}
Dbg.Builtin = {
    World = { kind = "table", keys = { "fg", "bg", "w", "h", "spawn" } },
    Inv = { kind = "table", keys = { "slots", "capacity" } },
    Menu = { kind = "table", keys = { "openBackpack", "ui" } },
    Gems = { kind = "table", keys = { "addGems" } },
    Hud = { kind = "table", keys = { "punchRange", "handPower" } },
    Others = { kind = "table", keys = { "list", "where", "playerAt" } },
    StateVal = { kind = "table", keys = { "x", "y", "facing", "vx" } },
    SetTile = { kind = "function", consts = { "tile", "placedAt", "flips" } },
    Punch = { kind = "function", consts = { "Empty the Vending Machine first!", "newCrack" } },
    Arm = { kind = "function", consts = { "forearm", "heldReach", "punchReach" } },
}

function Dbg.nameOf(k)
    return string.match(k, "^(.*):%a+$") or k
end

function Dbg.keys(t)
    local keys, nNum, sample = {}, 0, nil
    pcall(function()
        local n = 0
        for k, v in next, t do
            n = n + 1
            if n > 5000 then
                break
            end
            if type(k) == "string" then
                if #keys < 150 then
                    keys[#keys + 1] = k .. ":" .. type(v)
                end
            else
                nNum = nNum + 1
                if sample == nil and type(v) == "table" then
                    sample = v
                end
            end
        end
    end)
    table.sort(keys)
    return keys, nNum, sample
end

function Dbg.fn(fn)
    local e = { kind = "function", consts = {} }
    pcall(function() e.src = tostring(debug.info(fn, "s")) end)
    pcall(function() e.line = debug.info(fn, "l") end)
    pcall(function() e.np = debug.info(fn, "a") end)
    if getconsts then
        pcall(function()
            local seen = {}
            for _, c in pairs(getconsts(fn)) do
                if type(c) == "string" and #c > 0 and #c <= 60 and not seen[c] then
                    seen[c] = true
                    e.consts[#e.consts + 1] = c
                end
            end
        end)
    end
    table.sort(e.consts)
    while #e.consts > 100 do
        table.remove(e.consts)
    end
    return e
end

function Dbg.entry(v)
    if type(v) == "function" then
        return Dbg.fn(v)
    elseif type(v) == "table" then
        local keys, nNum, sample = Dbg.keys(v)
        local e = { kind = "table", keys = keys, num = nNum }
        if sample then
            e.sample = Dbg.keys(sample)
        end
        return e
    end
    return nil
end

function Dbg.diff(old, new)
    local so, sn = {}, {}
    for _, k in ipairs(old or {}) do
        so[Dbg.nameOf(k)] = k
    end
    for _, k in ipairs(new or {}) do
        sn[Dbg.nameOf(k)] = k
    end
    local gone, added, typ = {}, {}, {}
    for n, k in pairs(so) do
        local k2 = sn[n]
        if k2 == nil then
            gone[#gone + 1] = n
        elseif k2 ~= k and k ~= n and k2 ~= n then
            typ[#typ + 1] = k .. " -> " .. string.sub(k2, #n + 2)
        end
    end
    for n in pairs(sn) do
        if so[n] == nil then
            added[#added + 1] = n
        end
    end
    table.sort(gone)
    table.sort(added)
    table.sort(typ)
    return gone, added, typ
end

function Dbg.join(list, max)
    local out = {}
    for i, k in ipairs(list) do
        if i > max then
            out[#out + 1] = "...+" .. (#list - max)
            break
        end
        out[#out + 1] = tostring(k)
    end
    return #out > 0 and table.concat(out, ", ") or "-"
end

function Dbg.candidates(missing)
    local out = {}
    local tabs, fns = {}, {}
    for name, b in pairs(missing) do
        out[name] = {}
        if b.kind == "table" and #(b.keys or {}) > 0 then
            local names = {}
            for _, k in ipairs(b.keys) do
                names[#names + 1] = Dbg.nameOf(k)
            end
            tabs[#tabs + 1] = { name = name, names = names, need = math.min(#names, math.max(2, math.ceil(#names * 0.4))) }
        elseif b.kind == "function" and #(b.consts or {}) > 0 then
            local set = {}
            for _, c in ipairs(b.consts) do
                set[c] = true
            end
            fns[#fns + 1] = { name = name, set = set, total = #b.consts,
                need = math.min(#b.consts, math.max(1, math.ceil(#b.consts * 0.34))) }
        end
    end
    if not getgc then
        return out, "getgc tidak ada di executor ini: kandidat tidak bisa dicari"
    end
    local okG, gc = pcall(getgc, true)
    if not okG or type(gc) ~= "table" then
        return out, "getgc(true) gagal: " .. tostring(gc)
    end
    local function push(list, c)
        if #list >= 3 and c.score <= list[#list].score then
            return
        end
        list[#list + 1] = c
        table.sort(list, function(a, b)
            return a.score > b.score
        end)
        while #list > 3 do
            table.remove(list)
        end
    end
    for i, v in ipairs(gc) do
        if i % 2000 == 0 then
            task.wait()
        end
        local tv = type(v)
        if tv == "table" and #tabs > 0 then
            for _, q in ipairs(tabs) do
                local hit = 0
                pcall(function()
                    for j, k in ipairs(q.names) do
                        if rawget(v, k) ~= nil then
                            hit = hit + 1
                        end
                        if j == 8 and hit == 0 then
                            break -- 8 kunci pertama tidak ada satu pun: bukan objek ini
                        end
                    end
                end)
                if hit >= q.need then
                    push(out[q.name], { score = hit / #q.names, hit = hit, total = #q.names, v = v })
                end
            end
        elseif tv == "function" and #fns > 0 and getconsts and isGameFn(v) then
            local okc, consts = pcall(getconsts, v)
            if okc and type(consts) == "table" then
                for _, q in ipairs(fns) do
                    local hit, seen = 0, {}
                    for _, c in pairs(consts) do
                        if type(c) == "string" and q.set[c] and not seen[c] then
                            seen[c] = true
                            hit = hit + 1
                        end
                    end
                    if hit >= q.need then
                        push(out[q.name], { score = hit / q.total, hit = hit, total = q.total, v = v })
                    end
                end
            end
        end
    end
    return out
end

