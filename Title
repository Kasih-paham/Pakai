-- ================= MODE SEMUA TITLE: cari di data game =================
local mode = "pemain"
local catText = ""
local TPAT = { "of legend", "^dr%.", "^mighty", "legend", " of the ", "^sir ", "^lord ", "^king ", "^queen " }
local function isTitleStr(v)
    if type(v) ~= "string" or #v > 60 or #v < 3 then return false end
    local l = string.lower(strip(v))
    for _, p in ipairs(TPAT) do
        if string.find(l, p) then return true end
    end
    return false
end
local function short(v, depth)
    depth = depth or 0
    if type(v) ~= "table" then return strip(v) end
    if depth > 1 then return "{...}" end
    local out, n = {}, 0
    for k, x in pairs(v) do
        n += 1
        if n > 10 then
            out[#out + 1] = "..."
            break
        end
        out[#out + 1] = tostring(k) .. "=" .. (type(x) == "function" and "fn" or short(x, depth + 1))
    end
    return "{" .. table.concat(out, ", ") .. "}"
end

local function scanCatalog()
    local L = {}
    local function add(t) L[#L + 1] = t end
    add("=== Semua title di data game (SkyP Title Detector) ===")
    -- modul yang diperiksa: dari SkyP (tanpa require) + semua modul yang dimuat game
    local mods, seenMod = {}, {}
    local S = skyp()
    if S and type(S.Found) == "table" then
        for k, v in pairs(S.Found) do
            if type(v) == "table" and not seenMod[v] then
                seenMod[v] = true
                mods[#mods + 1] = { name = "SkyP." .. tostring(k), t = v }
            end
        end
    end
    if type(getloadedmodules) == "function" then
        local t0 = os.clock()
        for _, m in ipairs(getloadedmodules()) do
            if os.clock() - t0 > 25 then break end
            local ok, v = tryRequire(m)
            if ok and type(v) == "table" and not seenMod[v] then
                seenMod[v] = true
                mods[#mods + 1] = { name = m.Name, t = v }
            end
        end
    end
    -- modul Roles: semua isinya
    local R = findRoles()
    if R then
        add("-- Modul Roles --")
        for k, v in pairs(R) do
            if type(v) == "table" then
                local c = 0
                for _ in pairs(v) do c += 1 end
                add(("  %s = tabel %d isi: %s"):format(tostring(k), c, short(v)))
            else
                add(("  %s = %s"):format(tostring(k), type(v) == "function" and "fn" or strip(v)))
            end
        end
    end
    -- telusuri: teks yang mirip title + tabel yang namanya mengandung "title"
    local hits, tabs, seen = {}, {}, {}
    for _, m in ipairs(mods) do
        local nodes = 0
        local function walk(t, path, depth)
            if seen[t] or nodes > 4000 then return end
            seen[t] = true
            nodes += 1
            pcall(function()
                for k, v in pairs(t) do
                    local kp = path .. "." .. tostring(k)
                    if isTitleStr(v) and #hits < 300 then
                        hits[#hits + 1] = ("%s = %s"):format(kp, strip(v))
                    end
                    if type(v) == "table" then
                        if type(k) == "string" and string.find(string.lower(k), "title") and #tabs < 20 then
                            local c = 0
                            for _ in pairs(v) do c += 1 end
                            tabs[#tabs + 1] = { path = kp, t = v, n = c }
                        end
                        if depth < 4 then walk(v, kp, depth + 1) end
                    end
                end
            end)
        end
        walk(m.t, m.name, 0)
    end
    add(("-- Tabel bernama 'title': %d --"):format(#tabs))
    for _, e in ipairs(tabs) do
        add(("  %s (%d isi)"):format(e.path, e.n))
        local n = 0
        for k, v in pairs(e.t) do
            n += 1
            if n > 40 then
                add("    ...")
                break
            end
            add(("    %s = %s"):format(tostring(k), type(v) == "function" and "fn" or short(v)))
        end
    end
    add(("-- Teks mirip title: %d --"):format(#hits))
    for _, h in ipairs(hits) do add("  " .. h) end
    add(("-- %d modul diperiksa --"):format(#mods))
    return L
end

local function showLines(lines)
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("TextLabel") or c:IsA("Frame") then c:Destroy() end
    end
    for n, t in ipairs(lines) do
        if n > 400 then break end
        label(list, { Text = t, TextSize = 11, TextWrapped = true, Size = UDim2.new(1, -6, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = n,
            TextColor3 = string.sub(t, 1, 2) == "--" and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(230, 235, 245) })
    end
end

local function runCatalog()
    info.Text = "Mencari semua title di data game... (bisa 5-30 detik)"
    showLines({ "Mencari..." })
    task.spawn(function()
        local ok, lines = pcall(scanCatalog)
        if not App.alive or mode ~= "title" then return end
        if not ok then lines = { "Error: " .. tostring(lines) } end
        catText = table.concat(lines, "\n")
        showLines(lines)
        info.Text = ("Selesai: %d baris. Tekan Salin lalu tempel ke developer"):format(#lines)
    end)
end

local onlySpecial = true
local minimized = false
local lastText = ""
local known = {} -- [userId] = true: sudah pernah diberi notifikasi

local function refresh()
    if mode ~= "pemain" then return end
    if info.Text == "-" then info.Text = "Mencari data game..." end
    findRoles() -- boleh tidak ketemu: title di nama tetap terbaca
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local rows, total, special = {}, 0, 0
    local src = {}
    local O = findOthers()
    local okL, wl = false, nil
    if O then okL, wl = pcall(O.list) end
    if okL and type(wl) == "table" then
        App.src = "world ini"
        for _, e in ipairs(wl) do
            if type(e) == "table" then
                local uid = tonumber(e[1] or e.userId)
                local nm = strip(e[2] or e.name or uid)
                src[#src + 1] = { uid = uid, name = nm, extra = extras(e), raw = e }
            end
        end
    else
        App.src = "server (data world tidak ketemu: jalankan SkyP dulu)"
        for _, p in ipairs(Players:GetPlayers()) do src[#src + 1] = p end
    end
    App.raw = {}
    for _, p in ipairs(src) do
        total += 1
        local i = infoOf(p)
        if p.raw and #App.raw < 15 then
            local parts = {}
            for k, v in pairs(p.raw) do parts[#parts + 1] = tostring(k) .. "=" .. strip(v) end
            App.raw[#App.raw + 1] = "{" .. table.concat(parts, ", ") .. "}"
        end
        if i.special then special += 1 end
        if i.special or not onlySpecial then rows[#rows + 1] = { p = p, i = i } end
    end
    table.sort(rows, function(a, b)
        local sa = (a.i.staff and 2 or 0) + (#a.i.titles > 0 and 1 or 0)
        local sb = (b.i.staff and 2 or 0) + (#b.i.titles > 0 and 1 or 0)
        if sa ~= sb then return sa > sb end
        return a.i.name < b.i.name
    end)
    local lines = {}
    for n, r in ipairs(rows) do
        local i = r.i
        local tags = {}
        if i.staff then tags[#tags + 1] = i.staff end
        if i.under then tags[#tags + 1] = "undercover" end
        if i.nameTitle then tags[#tags + 1] = "title di nama" end
        for _, t in ipairs(i.titles) do tags[#tags + 1] = t end
        if i.extra and i.extra ~= "" then tags[#tags + 1] = i.extra end
        local tagText = #tags > 0 and table.concat(tags, ", ") or "-"
        lines[#lines + 1] = i.name .. " : " .. tagText
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, 36)
        row.BackgroundColor3 = i.staff and Color3.fromRGB(70, 30, 40) or Color3.fromRGB(28, 34, 48)
        row.BorderSizePixel = 0
        row.LayoutOrder = n
        row.Parent = list
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        label(row, { Text = i.name, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(8, 2),
            Size = UDim2.new(1, -16, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
        label(row, { Text = tagText, TextSize = 11, Position = UDim2.fromOffset(8, 18), Size = UDim2.new(1, -16, 0, 14),
            TextColor3 = i.staff and Color3.fromRGB(255, 140, 150) or Color3.fromRGB(120, 200, 255),
            TextTruncate = Enum.TextTruncate.AtEnd })
        -- notifikasi pemain ber-title / staff yang baru terlihat
        local key = i.uid or i.name
        if i.special and key and not known[key] and i.uid ~= LocalPlayer.UserId then
            known[key] = true
            if App.started then notify(i.staff and "STAFF terdeteksi" or "Pemain ber-title", i.name .. " : " .. tagText) end
        end
    end
    info.Text = ("%s: %d pemain | ber-title / staff: %d"):format(tostring(App.src), total, special)
    lastText = table.concat(lines, "\n") .. "\n\n-- data mentah --\n" .. table.concat(App.raw or {}, "\n")
    App.started = true
end

