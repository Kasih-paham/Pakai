-- SkyP Title Detector (script terpisah dari SkyP)
-- Menampilkan title / role semua pemain di server ini, dibaca dari modul Roles game
-- (titlesOf, titleName, isModerator, isDeveloper, isUndercover). Hanya MEMBACA, tidak mengirim apa pun ke server.
-- Pemain baru yang punya title / staff -> notifikasi.
-- Catatan: efek nama buatan script (mis. nama rainbow) hanya ada di layar pemakainya, jadi TIDAK bisa dideteksi.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local G = (getgenv and getgenv()) or _G
if G.__SkyPTitle and G.__SkyPTitle.stop then pcall(G.__SkyPTitle.stop) end
local App = { alive = true, conns = {} }
G.__SkyPTitle = App

local function notify(t, msg)
    pcall(function() StarterGui:SetCore("SendNotification", { Title = t, Text = msg, Duration = 5 }) end)
end
local function strip(s) return (tostring(s or ""):gsub("`.", "")) end

-- ---------- cari modul Roles game (nama modul diacak tiap update: dicari lewat isinya) ----------
local Roles
local function findRoles()
    if Roles then return Roles end
    if type(getloadedmodules) ~= "function" then return nil end
    for _, m in ipairs(getloadedmodules()) do
        local ok, v = pcall(require, m)
        if ok and type(v) == "table" and type(rawget(v, "titlesOf")) == "function"
            and type(rawget(v, "isModerator")) == "function" then
            Roles = v
            break
        end
    end
    return Roles
end

local function call(name, ...)
    local f = Roles and rawget(Roles, name)
    if type(f) ~= "function" then return nil end
    local ok, r = pcall(f, ...)
    if ok then return r end
    return nil
end

-- info 1 pemain: { name, titles = {...}, staff = "Developer" / "Moderator" / nil, under = bool }
local function infoOf(p)
    local uid = p.UserId
    local out = { name = p.DisplayName ~= p.Name and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name, titles = {} }
    if call("isDeveloper", uid) then out.staff = "Developer" elseif call("isModerator", uid) then out.staff = "Moderator" end
    out.under = call("isUndercover", uid) == true
    local list = call("titlesOf", uid)
    if type(list) == "table" then
        for _, key in ipairs(list) do
            if type(key) == "string" then
                local nm = call("titleName", key)
                nm = (type(nm) == "string" and nm ~= "") and strip(nm) or key
                out.titles[#out.titles + 1] = nm
            end
        end
    end
    out.special = out.staff ~= nil or out.under or #out.titles > 0
    return out
end

