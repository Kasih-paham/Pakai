            local d = i.Position - start
            main.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
        end
    end))
end

local onlySpecial = true
local minimized = false
local lastText = ""
local known = {} -- [userId] = true: sudah pernah diberi notifikasi

local function refresh()
    if not findRoles() then
        info.Text = "Modul Roles game belum ketemu (tunggu game selesai dimuat)"
        return
    end
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    local rows, total, special = {}, 0, 0
    for _, p in ipairs(Players:GetPlayers()) do
        total += 1
        local i = infoOf(p)
        if i.special then special += 1 end
        if i.special or not onlySpecial then rows[#rows + 1] = { p = p, i = i } end
    end
    table.sort(rows, function(a, b)
        local sa = (a.i.staff and 2 or 0) + (#a.i.titles > 0 and 1 or 0)
        local sb = (b.i.staff and 2 or 0) + (#b.i.titles > 0 and 1 or 0)
        if sa ~= sb then return sa > sb end
        return a.i.name < b.i.name
    end)
    local lines = {}
    for n, r in ipairs(rows) do
        local i = r.i
        local tags = {}
        if i.staff then tags[#tags + 1] = i.staff end
        if i.under then tags[#tags + 1] = "undercover" end
        for _, t in ipairs(i.titles) do tags[#tags + 1] = t end
        local tagText = #tags > 0 and table.concat(tags, ", ") or "-"
        lines[#lines + 1] = i.name .. " : " .. tagText
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, 36)
        row.BackgroundColor3 = i.staff and Color3.fromRGB(70, 30, 40) or Color3.fromRGB(28, 34, 48)
        row.BorderSizePixel = 0
        row.LayoutOrder = n
        row.Parent = list
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
        label(row, { Text = i.name, Font = Enum.Font.GothamBold, Position = UDim2.fromOffset(8, 2),
            Size = UDim2.new(1, -16, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
        label(row, { Text = tagText, TextSize = 11, Position = UDim2.fromOffset(8, 18), Size = UDim2.new(1, -16, 0, 14),
            TextColor3 = i.staff and Color3.fromRGB(255, 140, 150) or Color3.fromRGB(120, 200, 255),
            TextTruncate = Enum.TextTruncate.AtEnd })
        -- notifikasi pemain ber-title / staff yang baru terlihat
        if i.special and not known[r.p.UserId] and r.p ~= LocalPlayer then
            known[r.p.UserId] = true
            if App.started then notify(i.staff and "STAFF terdeteksi" or "Pemain ber-title", i.name .. " : " .. tagText) end
        end
    end
    info.Text = ("Server: %d pemain | ber-title / staff: %d | tampil: %d"):format(total, special, #rows)
    lastText = table.concat(lines, "\n")
    App.started = true
end

onlyBtn.MouseButton1Click:Connect(function()
    onlySpecial = not onlySpecial
    onlyBtn.Text = "Hanya ber-title: " .. (onlySpecial and "NYALA" or "MATI")
    refresh()
end)
copyBtn.MouseButton1Click:Connect(function()
    local clip = setclipboard or toclipboard
    if type(clip) == "function" and pcall(clip, lastText) then
        notify("Title Detector", "Daftar disalin ke clipboard")
    else
        notify("Title Detector", "Executor tidak bisa menyalin")
    end
end)
minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    list.Visible, info.Visible = not minimized, not minimized
    main.Size = minimized and UDim2.fromOffset(300, 64) or UDim2.fromOffset(300, 300)
    minBtn.Text = minimized and "+" or "–"
end)

function App.stop()
    App.alive = false
    for _, c in ipairs(App.conns) do pcall(function() c:Disconnect() end) end
    if gui.Parent then gui:Destroy() end
end
close.MouseButton1Click:Connect(App.stop)

table.insert(App.conns, Players.PlayerAdded:Connect(function()
    task.wait(2) -- tunggu data title pemain baru masuk
    if App.alive then pcall(refresh) end
end))
table.insert(App.conns, Players.PlayerRemoving:Connect(function()
    task.defer(function() if App.alive then pcall(refresh) end end)
end))

task.spawn(function()
    while App.alive do
        pcall(refresh)
        task.wait(10)
    end
end)
notify("Title Detector", "Jalan. Tekan × untuk menutup")
