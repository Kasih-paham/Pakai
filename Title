-- argumen menunjuk karakter sendiri? (UserId / nama / Player / karakter / data pemain {uid, nama})
local myId, myName = LocalPlayer.UserId, LocalPlayer.Name
local myDisp = LocalPlayer.DisplayName
local function isMe(...)
    local n = select("#", ...)
    for i = 1, math.min(n, 4) do
        local a = select(i, ...)
        if a == myId or a == LocalPlayer or (a ~= nil and a == LocalPlayer.Character) then return true end
        if type(a) == "string" and (a == myName or a == myDisp or a == tostring(myId)) then return true end
        if type(a) == "table" then
            local u = rawget(a, 1) or rawget(a, "userId") or rawget(a, "uid") or rawget(a, "id") or rawget(a, "UserId")
            if u == myId or tonumber(u) == myId then return true end
            local nm = rawget(a, "name") or rawget(a, "Name") or rawget(a, 2)
            if nm == myName then return true end
        end
    end
    return false
end

-- ---------- catatan diagnosa: argumen & jawaban asli tiap fungsi (maks 8 pola berbeda per fungsi) ----------
F.Log = {}      -- [nama] = { pola, ... }
F.LogSeen = {}  -- [nama] = { [pola] = true }
local function short(v, deep)
    local t = typeof(v)
    if v == nil then return "nil" end
    if t == "string" then return '"' .. string.sub(v, 1, 28) .. '"' end
    if t == "number" or t == "boolean" then return tostring(v) end
    if t == "Instance" then
        local ok, s = pcall(function() return v.ClassName .. ":" .. v.Name end)
        return ok and s or "Instance"
    end
    if t == "table" then
        if deep then return "{..}" end
        local parts, c = {}, 0
        for k, x in pairs(v) do
            c += 1
            if c > 5 then parts[#parts + 1] = "..." break end
            parts[#parts + 1] = tostring(k) .. "=" .. short(x, true)
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    if t == "function" then return "fn" end
    if t == "Color3" then return ("rgb(%d,%d,%d)"):format(math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5)) end
    if t == "ColorSequence" then
        local parts = {}
        for _, k in ipairs(v.Keypoints) do
            parts[#parts + 1] = ("%d,%d,%d"):format(math.floor(k.Value.R * 255 + 0.5), math.floor(k.Value.G * 255 + 0.5), math.floor(k.Value.B * 255 + 0.5))
        end
        return "CS[" .. table.concat(parts, " | ") .. "]"
    end
    if t == "Vector2" or t == "UDim2" or t == "EnumItem" then return tostring(v) end
    return t
end
local function logCall(name, me, ret, src, ...)
    local seen = F.LogSeen[name]
    if not seen then seen = {} F.LogSeen[name] = seen F.Log[name] = {} end
    if #F.Log[name] >= 8 or (F.Calls[name] or 0) > 3000 then return end
    local args = {}
    for i = 1, math.min(select("#", ...), 4) do args[i] = short((select(i, ...))) end
    src = type(src) == "string" and (" @" .. (string.match(src, "([^%.]+)$") or src)) or ""
    local key = "(" .. table.concat(args, ", ") .. ") -> " .. short(ret) .. (me and " [AKU]" or "") .. src
    if not seen[key] then
        seen[key] = true
        table.insert(F.Log[name], key)
    end
end

local function wrap(name, rule)
    local orig = rawget(R, name)
    if type(orig) ~= "function" or F.Orig[name] then return end
    F.Orig[name] = orig
    F.Calls[name] = 0
    rawset(R, name, function(...)
        F.Calls[name] += 1
        local res = table.pack(orig(...))
        local me = isMe(...)
        local lg = F.Log[name]
        if not lg or #lg < 8 then
            local okS, src = pcall(debug.info, 2, "s") -- script yang memanggil
            pcall(logCall, name, me, res[1], okS and src or nil, ...)
        end
        if F.On and rule then
            local ok, handled, v = pcall(rule, me, select("#", ...), res[1], ...)
            if ok and handled then return v end
        end
        return table.unpack(res, 1, res.n)
    end)
end

local function tbl(name) local t = rawget(R, name) return type(t) == "table" and t or nil end
local function guildValue(r)
    if type(r) == "number" then return F.Guild end
    local tags = tbl("GUILD_TAGS")
    return (tags and tags[F.Guild]) or GUILD_TXT[F.Guild]
end

local function hook()
    -- "of Legend" & "Dr." (sudah terbukti jalan)
    wrap("legendOn", function(me) if me and F.Legend then return true, true end end)
    wrap("hasDr", function(me) if me and F.Dr then return true, true end end)
    wrap("drOn", function(me) if me and F.Dr then return true, true end end)
    wrap("drHidden", function(me) if me and F.Dr then return true, false end end)

    -- title: game punya beberapa jalur, semuanya dicoba
    wrap("titleOf", function(me) if me and F.Title then return true, F.Title end end)
    wrap("ownTitle", function(me, n, r, a1, a2)
        if not F.Title then return end
        if type(r) == "boolean" then -- bentuk "punya title ini?"
            if me or a1 == F.Title or a2 == F.Title then return true, true end
            return
        end
        if me or n == 0 then return true, F.Title end
    end)
    wrap("tagKey", function(me, n, r)
        if me and F.Title and (r == nil or type(r) == "string") then return true, F.Title end
    end)
    wrap("titlesOf", function(me, n, r)
        if not (me and F.Title) then return end
        if type(r) == "table" then
            if table.find(r, F.Title) or r[F.Title] then return end
            local c = table.clone(r)
            if #r > 0 or next(r) == nil then c[#c + 1] = F.Title else c[F.Title] = true end
            return true, c
        end
        if r == nil then return true, { F.Title } end
    end)
    wrap("titleName", function(me)
        if me and F.Title then
            local nm, t = tbl("TITLE_NAMES"), tbl("TITLES")
            return true, (nm and nm[F.Title]) or (t and t[F.Title]) or F.Title
        end
    end)
    wrap("tagSize", function(me)
        local sz = tbl("TITLE_SIZES")
        if me and F.Title and sz and sz[F.Title] then return true, sz[F.Title] end
    end)
    -- v3: game mengembalikan TEKS gambar ("rbxassetid://..."), bukan tabel {scale, image}.
    -- Badge title dipaksa juga saat "of Legend" nyala (kalau tidak, bola Legend yang tampil).
    wrap("badgeOf", function(me)
        local b = tbl("TITLE_BADGES")
        local e = me and F.Title and b and b[F.Title]
        if type(e) == "table" then e = rawget(e, "image") end
        if type(e) == "string" then return true, e end
    end)
    wrap("wrenchOf", nil) -- hanya dicatat
    -- v4: warna nama title. tagColor asli = nil untuk akun tanpa title, jadi warna diambil dari titleColor(kunci title)
    wrap("tagColor", function(me)
        if not (me and F.Title) then return end
        local tc = F.Orig.titleColor or rawget(R, "titleColor")
        if type(tc) ~= "function" then return end
        local ok, c = pcall(tc, F.Title)
        if ok and c ~= nil then return true, c end
    end)
    -- hanya dicatat (bentuk jawabannya belum diketahui)
    for _, nm in ipairs({ "titleColor", "tagText", "stillTag", "nameKey", "nameCode", "nameOf", "lineName" }) do
        wrap(nm, nil)
    end

    -- tag guild: game memakai guildTag (guildRankTag tidak dipanggil untuk nama)
    wrap("guildTag", function(me, n, r) if me and F.Guild then return true, guildValue(r) end end)
    wrap("guildRankTag", function(me, n, r) if me and F.Guild then return true, guildValue(r) end end)
end

local function unhook()
    if not R then return end
    for name, orig in pairs(F.Orig) do pcall(rawset, R, name, orig) end
    table.clear(F.Orig)
end

