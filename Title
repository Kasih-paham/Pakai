-- ---------- cari modul Roles game (nama modul diacak tiap update: dicari lewat isinya) ----------
local Roles, Others
local function skyp() -- data dari SkyP yang sedang jalan
    local S = G.__Alfian
    return type(S) == "table" and S or nil
end
-- require dengan batas waktu (modul yang masih dimuat bisa menahan selamanya)
local function tryRequire(m)
    local done, ok, v = false, false, nil
    task.spawn(function()
        ok, v = pcall(require, m)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < 0.3 do task.wait() end
    return done and ok, v
end
local searched = false
local function findRoles()
    if Roles then return Roles end
    local S = skyp()
    if S and type(S.Found) == "table" and type(S.Found.Roles) == "table" then
        Roles = S.Found.Roles
        return Roles
    end
    if searched or type(getloadedmodules) ~= "function" then return nil end
    searched = true
    for _, m in ipairs(getloadedmodules()) do
        local ok, v = tryRequire(m)
        if ok and type(v) == "table" and type(rawget(v, "titlesOf")) == "function"
            and type(rawget(v, "isModerator")) == "function" then
            Roles = v
            break
        end
    end
    return Roles
end
-- daftar pemain di world (punya list(), where(), playerAt())
local othersSearched = false
local function findOthers()
    local S = skyp()
    if S and type(S.Refs) == "table" and type(S.Refs.Others) == "table" then
        Others = S.Refs.Others
        return Others
    end
    if Others or othersSearched then return Others end
    othersSearched = true
    if type(getgc) ~= "function" then return nil end
    pcall(function()
        for i, v in ipairs(getgc(true)) do
            if i % 4000 == 0 then task.wait() end
            if type(v) == "table" and type(rawget(v, "list")) == "function" and type(rawget(v, "where")) == "function"
                and type(rawget(v, "playerAt")) == "function" then
                Others = v
                break
            end
        end
    end)
    return Others
end

local function call(name, ...)
    local f = Roles and rawget(Roles, name)
    if type(f) ~= "function" then return nil end
    local ok, r = pcall(f, ...)
    if ok then return r end
    return nil
end

-- isi lain data pemain world (selain id & nama) -> teks singkat
local function extras(e)
    local out, n = {}, 0
    for k, v in pairs(e) do
        if k ~= 1 and k ~= 2 and k ~= "userId" and k ~= "name" and type(v) ~= "function" and type(v) ~= "table" then
            local sv = strip(v)
            if sv ~= "" and sv ~= "0" and sv ~= "false" then
                n += 1
                if n > 6 then break end
                out[#out + 1] = tostring(k) .. "=" .. sv
            end
        end
    end
    return table.concat(out, " ")
end
-- nama yang tampil punya title? (nama biasa = 1 kata tanpa spasi / kurung)
local function nameTitle(name)
    return string.find(name, "[%s%(%[]") ~= nil
end

-- info 1 pemain: { name, titles = {...}, staff = "Developer" / "Moderator" / nil, under = bool }
-- p = { uid, name (nama di world), extra } atau Player Roblox
local function infoOf(p)
    local uid = p.uid or p.UserId
    local rname = p.name or (p.DisplayName ~= p.Name and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name)
    local out = { name = rname, titles = {}, uid = uid }
    out.nameTitle = p.name ~= nil and nameTitle(p.name)
    out.extra = p.extra
    if call("isDeveloper", uid) then out.staff = "Developer" elseif call("isModerator", uid) then out.staff = "Moderator" end
    out.under = call("isUndercover", uid) == true
    local list = call("titlesOf", uid)
    if type(list) == "table" then
        for _, key in ipairs(list) do
            if type(key) == "string" then
                local nm = call("titleName", key)
                nm = (type(nm) == "string" and nm ~= "") and strip(nm) or key
                out.titles[#out.titles + 1] = nm
            end
        end
    end
    out.special = out.staff ~= nil or out.under or #out.titles > 0 or out.nameTitle
    return out
end

