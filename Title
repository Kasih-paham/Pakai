    local names = {}
    for name in pairs(F.Calls) do names[#names + 1] = name end
    table.sort(names)
    for _, name in ipairs(names) do
        out[#out + 1] = ("%s  (dipanggil %d)"):format(name, F.Calls[name])
        for _, line in ipairs(F.Log[name] or {}) do out[#out + 1] = "   " .. line end
    end
    pcall(probe, out)
    local okD, errD = pcall(dumpTag, out)
    if not okD then out[#out + 1] = "dump nametag gagal: " .. tostring(errD) end
    local txt = table.concat(out, "\n")
    local clip = setclipboard or toclipboard
    if type(clip) == "function" and pcall(clip, txt) then
        notify("Title Visual", "Diagnosa disalin, tempel ke developer")
    else
        notify("Title Visual", "Executor tidak bisa menyalin")
        print(txt)
    end
end)

