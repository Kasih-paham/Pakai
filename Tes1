-- geser jendela (mouse & sentuh)
do
    local dragging, startPos, startInput
    header.InputBegan:Connect(function(io)
        if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startInput = true, main.Position, io.Position
            io.Changed:Connect(function()
                if io.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    table.insert(D.conns, UIS.InputChanged:Connect(function(io)
        if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
            local d = io.Position - startInput
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
end

function D.stop()
    if not D.alive then return end
    D.alive = false
    for _, c in ipairs(D.conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
    if G.SkyPDebug == D then G.SkyPDebug = nil end
end
btnClose.MouseButton1Click:Connect(D.stop)

showPrevious()
startWatch()
