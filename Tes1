local function paint()
    local out = {}
    for i = math.max(1, #D.lines - 60), #D.lines do out[#out + 1] = D.lines[i] end
    logLabel.Text = table.concat(out, "\n")
end

-- ---------- catatan ke file ----------
local function fileAppend(line)
    if not canFile then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("Fian") then makefolder("Fian") end
        local prev = isfile(LOG) and readfile(LOG) or ""
        -- simpan maksimal ~400 baris terakhir supaya file tidak membengkak
        local _, n = string.gsub(prev, "\n", "")
        if n > 400 then
            local cut = string.find(prev, "\n", #prev - 20000, true)
            if cut then prev = string.sub(prev, cut + 1) end
        end
        writefile(LOG, prev .. line .. "\n")
    end)
end

local function log(line)
    line = ("[%s] %s"):format(nowStr(), tostring(line))
    table.insert(D.lines, line)
    fileAppend(line)
    paint()
end

-- ---------- bantuan deteksi ----------
local function playerGui() return LP:FindFirstChildOfClass("PlayerGui") end
local function hasGameGui()
    local pg = playerGui()
    return pg ~= nil and pg:FindFirstChild("GameGui") ~= nil
end
local function hasChar() return LP.Character ~= nil and LP.Character.Parent ~= nil end
local function placeInfo()
    local job = ""
    pcall(function() job = tostring(game.JobId):sub(1, 8) end)
    return ("place=%s job=%s"):format(tostring(game.PlaceId), job)
end

-- ---------- tampilkan sesi sebelumnya (kalau tadi mati) ----------
local function showPrevious()
    if not canFile then
        log("Executor tidak punya writefile: catatan tidak bisa disimpan ke file")
        return
    end
    local lastHb
    pcall(function() if isfile(HB) then lastHb = readfile(HB) end end)
    if lastHb then
        log("== SESI SEBELUMNYA ==")
        log("Heartbeat terakhir: " .. tostring(lastHb))
        log("(kalau waktunya pas kamu keluar world = VM Lua mati saat itu)")
    end
    local prev
    pcall(function() if isfile(LOG) then prev = readfile(LOG) end end)
    if prev and #prev > 0 then
        local tail = {}
        for line in string.gmatch(prev, "[^\n]+") do tail[#tail + 1] = line end
        local from = math.max(1, #tail - 25)
        table.insert(D.lines, "---- catatan file (25 baris terakhir) ----")
        for i = from, #tail do table.insert(D.lines, tail[i]) end
        table.insert(D.lines, "---- (catatan baru di bawah) ----")
        paint()
    end
end

-- ---------- rekam kejadian ----------
local function startWatch()
    log("=== SkyP Debug START (" .. placeInfo() .. ") ===")
    log(("Awal: GameGui=%s Character=%s"):format(tostring(hasGameGui()), tostring(hasChar())))
    log("GUI debug ini di: " .. gui.Parent.ClassName .. " (tetap ada walau PlayerGui reset)")

    -- OnTeleport: LocalPlayer dipindah server Roblox (ini = VM Lua akan mati)
    pcall(function()
        table.insert(D.conns, LP.OnTeleport:Connect(function(state)
            log("!!! OnTeleport state=" .. tostring(state) .. " (pindah server = script MATI, " .. placeInfo() .. ")")
        end))
    end)
    pcall(function()
        table.insert(D.conns, TPS.TeleportInitFailed:Connect(function(plr, res, msg)
            if plr == LP then log("TeleportInitFailed: " .. tostring(res) .. " " .. tostring(msg)) end
        end))
    end)
    -- layar error Roblox
    pcall(function()
        table.insert(D.conns, GuiService.ErrorMessageChanged:Connect(function(msg)
            if type(msg) == "string" and msg ~= "" then log("ERROR Roblox: " .. msg) end
        end))
    end)
    -- Character hilang/muncul
    pcall(function()
        table.insert(D.conns, LP.CharacterRemoving:Connect(function() log("Character HILANG (keluar world / respawn?)") end))
        table.insert(D.conns, LP.CharacterAdded:Connect(function() log("Character muncul lagi") end))
    end)

    -- loop pengamat 1 dtk: heartbeat + perubahan GameGui / place / job
    task.spawn(function()
        local prevGG = hasGameGui()
        local prevPlace, prevJob = game.PlaceId, nil
        pcall(function() prevJob = game.JobId end)
        local n = 0
        while D.alive do
            n += 1
            local gg = hasGameGui()
            if gg ~= prevGG then
                log(gg and ">> MASUK world (GameGui muncul)" or ">> KELUAR world (GameGui hilang) " .. placeInfo())
                prevGG = gg
            end
            if game.PlaceId ~= prevPlace then
                log("PlaceId berubah: " .. tostring(prevPlace) .. " -> " .. tostring(game.PlaceId))
                prevPlace = game.PlaceId
            end
            local job
            pcall(function() job = game.JobId end)
            if job ~= prevJob then
                log("JobId (server) berubah -> pindah server Roblox")
                prevJob = job
            end
            -- heartbeat ke file (ditimpa tiap detik): bukti script masih hidup sampai waktu ini
            if canFile then
                pcall(function()
                    writefile(HB, ("%s | %s | GameGui=%s Char=%s | detik ke-%d"):format(
                        nowStr(), placeInfo(), tostring(gg), tostring(hasChar()), n))
                end)
            end
            -- GUI debug ikut hilang? (tidak seharusnya)
            if gui.Parent == nil then
                fileAppend(("[%s] !!! GUI debug ikut hilang (parent nil)"):format(nowStr()))
            end
            task.wait(1)
        end
    end)
end

-- ---------- tombol ----------
bCopy.MouseButton1Click:Connect(function()
    local txt = "-- SkyP Debug Keluar World v" .. VERSION .. "\n"
    pcall(function() if canFile and isfile(HB) then txt = txt .. "Heartbeat terakhir: " .. readfile(HB) .. "\n" end end)
    pcall(function() if canFile and isfile(LOG) then txt = txt .. readfile(LOG) end end)
    if txt == "" then txt = table.concat(D.lines, "\n") end
