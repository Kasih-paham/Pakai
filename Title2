-- v13: MODE ATRIBUT. Data title game ada di atribut objek Player (lihat kode Roles):
--   WornTitle (title dipakai), HasLegend + HideLegendUntil (of Legend), DrTitle + WearDr + HideDrUntil (Dr.),
--   GuildRank (tag guild). Penggambar nama game (diproteksi) membaca atribut ini.
-- Atribut diubah di sisi client = hanya layar sendiri (tidak terkirim ke server). Nilai asli disimpan & dikembalikan.
F.AttrOrig = nil
local ATTRS = { "WornTitle", "HasLegend", "HideLegendUntil", "DrTitle", "WearDr", "HideDrUntil", "GuildRank" }
local function attrWant()
    return {
        WornTitle = F.Title or (F.Dr and "dr") or "none",
        HasLegend = F.Legend or nil,
        HideLegendUntil = F.Legend and 0 or nil,
        DrTitle = F.Dr or nil,
        WearDr = F.Dr or nil,
        HideDrUntil = F.Dr and 0 or nil,
        GuildRank = F.Guild,
    }
end
local function attrRestore()
    local o = F.AttrOrig
    if not o then return end
    F.AttrOrig = nil
    for _, k in ipairs(ATTRS) do
        pcall(function() LocalPlayer:SetAttribute(k, o[k]) end)
    end
end
local function attrTick()
    if not (F.On and F.Attr) then attrRestore() return end
    if not F.AttrOrig then
        local o = {}
        for _, k in ipairs(ATTRS) do o[k] = LocalPlayer:GetAttribute(k) end
        F.AttrOrig = o
    end
    local want = attrWant()
    for _, k in ipairs(ATTRS) do
        local v = want[k]
        if v == nil then v = F.AttrOrig[k] end -- pilihan "mati" = nilai asli akun
        if k == "HasLegend" and not F.Legend then v = F.AttrOrig[k] end
        if LocalPlayer:GetAttribute(k) ~= v then pcall(function() LocalPlayer:SetAttribute(k, v) end) end
    end
end
task.spawn(function()
    while App.alive do
        pcall(attrTick)
        task.wait(0.5)
    end
end)

function App.stop()
    App.alive = false
    attrRestore()
    unhook() -- fungsi game dikembalikan seperti semula
    badgeClear()
    fixRestore()
    colorRestore()
    for _, c in ipairs(App.conns) do pcall(function() c:Disconnect() end) end
