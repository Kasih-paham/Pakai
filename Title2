-- karena game tidak menggambar badge walau badgeOf sudah menjawab gambar title.
F.Badge = true
local badgeObj
F.Fixed = {}   -- [slot bendera] = potongan asli (dikembalikan saat title dimatikan)
F.Wrench = {}  -- [kotak wrench] = true (dimunculkan)
local function badgeClear()
