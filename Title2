        for name, n in pairs(F.Calls) do
            if n > 0 then parts[#parts + 1] = name .. " " .. n end
        end
        table.sort(parts)
        stat.Text = "Keluar-masuk world setelah memilih.\nDipanggil game: " .. table.concat(parts, ", ")
        task.wait(1)
    end
end)
