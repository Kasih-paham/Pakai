-- SkyP Title Visual (script terpisah, untuk mencoba dulu)
-- Mengubah tampilan title di nama SENDIRI, hanya di layar HP ini (server & pemain lain tetap melihat nama asli).
-- Cara kerja: fungsi modul Roles game (legendOn, hasDr / drOn, titleOf, badgeOf, wrenchOf, guildRankTag) dibungkus.
-- Kalau yang ditanya karakter sendiri, jawabannya diganti pilihan di menu ini.
-- Setelah cocok: tekan "Salin pilihan", tempel ke developer untuk dimasukkan ke script utama.
-- Title staff (Developer / Moderator / Admin) dan Content Creator sengaja tidak disediakan.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local G = (getgenv and getgenv()) or _G
if G.__SkyPTitleFx and G.__SkyPTitleFx.stop then pcall(G.__SkyPTitleFx.stop) end
local App = { alive = true, conns = {} }
G.__SkyPTitleFx = App

local function notify(t, msg)
    pcall(function() StarterGui:SetCore("SendNotification", { Title = t, Text = msg, Duration = 5 }) end)
end

-- ---------- cari modul Roles (dari SkyP kalau jalan, kalau tidak dicari sendiri) ----------
local function tryRequire(m)
    local done, ok, v = false, false, nil
    task.spawn(function()
        ok, v = pcall(require, m)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < 0.3 do task.wait() end
    return done and ok, v
end
local function findRoles()
    local S = G.__Alfian
    if type(S) == "table" and type(S.Found) == "table" and type(S.Found.Roles) == "table" then return S.Found.Roles end
    if type(getloadedmodules) ~= "function" then return nil end
    for _, m in ipairs(getloadedmodules()) do
        local ok, v = tryRequire(m)
        if ok and type(v) == "table" and type(rawget(v, "titlesOf")) == "function"
            and type(rawget(v, "isModerator")) == "function" then
            return v
        end
    end
    return nil
end

local R -- modul Roles
local F = { On = true, Legend = false, Dr = false, Title = nil, Guild = nil, Calls = {}, Orig = {} }
App.F = F
local TITLES = {}                 -- { { key, name } }
local GUILDS = { 0, 4, 3, 2 }     -- 0 = tidak ada / GL / GC / GE
local GUILD_TXT = { [4] = "(GL)", [3] = "(GC)", [2] = "(GE)" }

-- argumen menunjuk karakter sendiri? (UserId / nama / data pemain {uid, nama})
local myId, myName = LocalPlayer.UserId, LocalPlayer.Name
local function isMe(...)
    local n = select("#", ...)
    for i = 1, math.min(n, 4) do
        local a = select(i, ...)
        if a == myId or a == myName or a == LocalPlayer or (type(a) == "string" and a == tostring(myId)) then return true end
        if type(a) == "table" then
            local u = rawget(a, 1) or rawget(a, "userId") or rawget(a, "uid") or rawget(a, "id")
            if u == myId or tonumber(u) == myId then return true end
        end
    end
    return false
end

local function wrap(name, make)
    local orig = rawget(R, name)
    if type(orig) ~= "function" then return end
    F.Orig[name] = orig
    F.Calls[name] = 0
    rawset(R, name, make(orig, function() F.Calls[name] += 1 end))
end

local function hook()
    wrap("legendOn", function(orig, count)
        return function(...)
            count()
            if F.On and F.Legend and isMe(...) then return true end
            return orig(...)
        end
    end)
    for _, nm in ipairs({ "hasDr", "drOn" }) do
        wrap(nm, function(orig, count)
            return function(...)
                count()
                if F.On and F.Dr and isMe(...) then return true end
                return orig(...)
            end
        end)
    end
    wrap("drHidden", function(orig, count)
        return function(...)
            count()
            if F.On and F.Dr and isMe(...) then return false end
            return orig(...)
        end
    end)
    wrap("titleOf", function(orig, count)
        return function(...)
            count()
            if F.On and F.Title and isMe(...) then return F.Title end
            return orig(...)
        end
    end)
    wrap("titlesOf", function(orig, count)
        return function(...)
            count()
            local r = orig(...)
            if F.On and F.Title and isMe(...) and type(r) == "table" and not table.find(r, F.Title) then
                local c = table.clone(r)
                c[#c + 1] = F.Title
                return c
            end
            return r
        end
    end)
    wrap("badgeOf", function(orig, count)
        return function(...)
            count()
            local b = rawget(R, "TITLE_BADGES")
            if F.On and F.Title and isMe(...) and type(b) == "table" and b[F.Title] ~= nil then return b[F.Title] end
            return orig(...)
        end
    end)
    wrap("wrenchOf", function(orig, count)
        return function(...)
            count()
            local w = rawget(R, "TITLE_WRENCHES")
            if F.On and F.Title and isMe(...) and type(w) == "table" and w[F.Title] ~= nil then return w[F.Title] end
            return orig(...)
        end
    end)
    wrap("guildRankTag", function(orig, count)
        return function(...)
            count()
            local r = orig(...)
            if F.On and F.Guild and isMe(...) then
                if type(r) == "number" then return F.Guild end
                local tags = rawget(R, "GUILD_TAGS")
                return (type(tags) == "table" and tags[F.Guild]) or GUILD_TXT[F.Guild]
            end
            return r
        end
    end)
end

local function unhook()
    if not R then return end
    for name, orig in pairs(F.Orig) do pcall(rawset, R, name, orig) end
    table.clear(F.Orig)
end

