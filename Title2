local probe, dumpTag

-- v4: panggil fungsi Roles asli dengan kunci title & id sendiri, untuk melihat bentuk jawabannya
probe = function(out)
    out[#out + 1] = "-- uji fungsi (kunci title / id sendiri)"
    local key = F.Title or "sponsor"
    for _, nm in ipairs({ "titleColor", "titleName", "tagColor", "tagKey", "stillTag", "nameKey", "ownTitle",
        "tagSize", "badgeOf", "wrenchOf", "titleOf", "showsStaff", "drRed", "tagText" }) do
        local fn = F.Orig[nm] or rawget(R, nm)
        if type(fn) == "function" then
            local a = { pcall(fn, key) }
            local b = { pcall(fn, myId) }
            out[#out + 1] = ("   %s(%q) -> %s | %s(id) -> %s"):format(nm, key,
                a[1] and short(a[2]) or ("ERR " .. tostring(a[2])), nm, b[1] and short(b[2]) or ("ERR " .. tostring(b[2])))
        end
    end
end

-- v4: struktur nametag sendiri (kotak berisi "BitmapText" tepat di atas tengah layar)
dumpTag = function(out)
    out[#out + 1] = "-- struktur nametag"
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then out[#out + 1] = "PlayerGui tidak ada" return end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local cx, cy = vp.X / 2, vp.Y / 2
    local cands = {}
    for _, bm in ipairs(pg:GetDescendants()) do
        if bm.Name == "BitmapText" and bm:IsA("GuiObject") and bm.Visible and bm.AbsoluteSize.X > 0 then
            local o = bm.Parent
            if o and o:IsA("GuiObject") then
                local p, sz = bm.AbsolutePosition, bm.AbsoluteSize
                local dx = math.abs(p.X + sz.X / 2 - cx)
                local dy = cy - (p.Y + sz.Y / 2)
                if dx <= vp.X * 0.12 and dy > vp.Y * 0.02 and dy < vp.Y * 0.45 then
                    cands[#cands + 1] = { bm = bm, score = dx * 3 + dy }
                end
            end
        end
    end
    table.sort(cands, function(a, b) return a.score < b.score end)
    out[#out + 1] = ("kandidat: %d | layar %dx%d"):format(#cands, math.floor(vp.X), math.floor(vp.Y))
    local c = cands[1]
    if not c then return end
    local root = c.bm.Parent
    if root.Parent and root.Parent:IsA("GuiObject") then root = root.Parent end
    out[#out + 1] = "jalur: " .. root:GetFullName()
    local lines = 0
    local function props(o)
        local t = { o.ClassName, o.Name }
        if o:IsA("GuiObject") then
            local f = math.floor
            t[#t + 1] = ("vis=%s size=%dx%d pos=%d,%d"):format(tostring(o.Visible), f(o.AbsoluteSize.X), f(o.AbsoluteSize.Y),
                f(o.AbsolutePosition.X - cx), f(o.AbsolutePosition.Y - cy))
            if o.BackgroundTransparency < 1 then t[#t + 1] = "bg=" .. short(o.BackgroundColor3) end
        end
        if o:IsA("ImageLabel") or o:IsA("ImageButton") then
            t[#t + 1] = "img=" .. tostring(o.Image)
            if o.ImageColor3 ~= Color3.new(1, 1, 1) then t[#t + 1] = "col=" .. short(o.ImageColor3) end
            if o.ImageTransparency ~= 0 then t[#t + 1] = "tr=" .. o.ImageTransparency end
            if o.ImageRectSize ~= Vector2.zero then t[#t + 1] = "rect=" .. tostring(o.ImageRectOffset) .. "/" .. tostring(o.ImageRectSize) end
        elseif o:IsA("TextLabel") or o:IsA("TextButton") then
            t[#t + 1] = ("txt=%q col=%s"):format(string.sub(o.Text, 1, 40), short(o.TextColor3))
        elseif o:IsA("UIGradient") then
            t[#t + 1] = "grad=" .. short(o.Color) .. " en=" .. tostring(o.Enabled) .. " rot=" .. o.Rotation
        elseif o:IsA("UIStroke") then
            t[#t + 1] = "stroke=" .. short(o.Color) .. " th=" .. o.Thickness
        end
        local attrs = o:GetAttributes()
        if next(attrs) then t[#t + 1] = "attr=" .. short(attrs) end
        return table.concat(t, " ")
    end
    local function walk(o, depth)
        if lines >= 140 then return end
        lines += 1
        local ind = string.rep("  ", depth)
        if o.Name == "BitmapText" then
            local kids = o:GetChildren()
            local first = kids[1]
            out[#out + 1] = ind .. props(o) .. (" | %d huruf, huruf1=%s"):format(#kids, first and props(first) or "-")
            for _, k in ipairs(kids) do
                if not (k:IsA("ImageLabel") or k:IsA("ImageButton")) then walk(k, depth + 1) end
            end
            return
        end
        out[#out + 1] = ind .. props(o)
        if depth < 6 then
            for _, k in ipairs(o:GetChildren()) do walk(k, depth + 1) end
        end
    end
    walk(root, 0)
end

bDiag.MouseButton1Click:Connect(function()
