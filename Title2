    badgeObj = nil
end
local function fixRestore()
    for o, r in pairs(F.Fixed) do
        pcall(function() o.ImageRectOffset = r.off o.ImageRectSize = r.size end)
    end
    table.clear(F.Fixed)
    for fr in pairs(F.Wrench) do pcall(function() fr.Visible = false end) end
