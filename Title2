local bOn = btn("", 34)
local bLegend = btn("", 66)
local bDr = btn("", 98)
local bTitle = btn("", 130)
local bGuild = btn("", 162)
local bCopy = btn("Salin pilihan", 194)
local stat = label({ Text = "-", TextSize = 10, TextColor3 = Color3.fromRGB(150, 160, 180), TextWrapped = true,
    TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(12, 228), Size = UDim2.new(1, -24, 0, 54) })

local titleIdx, guildIdx = 0, 1
local function titleName()
    local t = TITLES[titleIdx]
    return t and (t.name .. " [" .. t.key .. "]") or "Tidak ada"
end
local function paint()
    bOn.Text = "Title visual: " .. (F.On and "NYALA" or "MATI")
    bLegend.Text = "of Legend: " .. (F.Legend and "NYALA" or "MATI")
    bDr.Text = "Dr.: " .. (F.Dr and "NYALA" or "MATI")
    bTitle.Text = "Title: " .. titleName() .. "  ›"
    bGuild.Text = "Tag guild: " .. (GUILD_TXT[GUILDS[guildIdx]] or "Tidak ada") .. "  ›"
end

bOn.MouseButton1Click:Connect(function() F.On = not F.On paint() end)
bLegend.MouseButton1Click:Connect(function() F.Legend = not F.Legend paint() end)
bDr.MouseButton1Click:Connect(function() F.Dr = not F.Dr paint() end)
bTitle.MouseButton1Click:Connect(function()
    titleIdx = (titleIdx + 1) % (#TITLES + 1)
    F.Title = TITLES[titleIdx] and TITLES[titleIdx].key or nil
    paint()
end)
bGuild.MouseButton1Click:Connect(function()
    guildIdx = guildIdx % #GUILDS + 1
    F.Guild = (GUILDS[guildIdx] ~= 0) and GUILDS[guildIdx] or nil
    paint()
end)
bCopy.MouseButton1Click:Connect(function()
    local calls = {}
    for name, n in pairs(F.Calls) do calls[#calls + 1] = name .. "=" .. n end
    table.sort(calls)
    local txt = ("-- Pilihan Title Visual (tempel ke developer)\nTITLE_FX = { legend = %s, dr = %s, title = %s, guild = %s }\n-- dipanggil game: %s"):format(
        tostring(F.Legend), tostring(F.Dr), F.Title and ('"' .. F.Title .. '"') or "nil",
        F.Guild and tostring(F.Guild) or "nil", table.concat(calls, ", "))
    local clip = setclipboard or toclipboard
    if type(clip) == "function" and pcall(clip, txt) then
        notify("Title Visual", "Pilihan disalin ke clipboard")
    else
        notify("Title Visual", "Executor tidak bisa menyalin")
    end
end)

-- geser jendela
do
    local drag, start, pos
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag, start, pos = true, i.Position, main.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    table.insert(App.conns, UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            main.Position = UDim2.new(pos.X.Scale, pos.X.Offset + d.X, pos.Y.Scale, pos.Y.Offset + d.Y)
        end
    end))
end

function App.stop()
    App.alive = false
    unhook() -- fungsi game dikembalikan seperti semula
    for _, c in ipairs(App.conns) do pcall(function() c:Disconnect() end) end
    if gui.Parent then gui:Destroy() end
end
close.MouseButton1Click:Connect(App.stop)

paint()
stat.Text = "Mencari modul Roles game..."
task.spawn(function()
    R = findRoles()
    if not App.alive then return end
    if not R then
        stat.Text = "Modul Roles game tidak ketemu. Jalankan SkyP dulu, lalu script ini"
        return
    end
    for _, src in ipairs({ rawget(R, "TITLES"), rawget(R, "TITLE_NAMES") }) do
        if type(src) == "table" then
            for k, nm in pairs(src) do
                if type(k) == "string" and k ~= "cc" then TITLES[#TITLES + 1] = { key = k, name = tostring(nm) } end
            end
        end
    end
    table.sort(TITLES, function(a, b) return a.name < b.name end)
    hook()
    paint()
    notify("Title Visual", "Siap. Pilih title, lalu keluar-masuk world supaya nama digambar ulang")
    while App.alive do
        local parts = {}
        for name, n in pairs(F.Calls) do parts[#parts + 1] = name .. " " .. n end
        table.sort(parts)
        stat.Text = "Keluar-masuk world setelah memilih.\nDipanggil game: " .. table.concat(parts, ", ")
        task.wait(1)
    end
end)
