-- v11: AMBIL KODE GAME. Modul Roles dan script penggambar nama di-decompile (kalau executor punya decompile),
-- supaya terlihat persis dari mana warna & efek tiap title diambil.
local function decompileText(inst)
    local dec = decompile or (syn and syn.decompile)
    if type(dec) ~= "function" then return nil, "executor tidak punya decompile" end
    local ok, txt = pcall(dec, inst)
    if not ok then return nil, tostring(txt) end
    if type(txt) ~= "string" or #txt < 10 then return nil, "hasil kosong" end
    return txt
end
local function allScripts()
    local list, seen = {}, {}
    for _, getter in ipairs({ getloadedmodules, getscripts, getrunningscripts }) do
        if type(getter) == "function" then
            local ok, arr = pcall(getter)
            if ok and type(arr) == "table" then
                for _, sc in ipairs(arr) do
                    if typeof(sc) == "Instance" and not seen[sc] then seen[sc] = true list[#list + 1] = sc end
                end
            end
        end
    end
    return list
end
local function findRolesInst()
    if type(getloadedmodules) ~= "function" then return nil end
    for _, m in ipairs(getloadedmodules()) do
        local ok, v = tryRequire(m)
        if ok and v == R then return m end
    end
    return nil
end
local function findByPath(path, fn)
    for _, sc in ipairs(allScripts()) do
        local ok, full = pcall(function() return sc:GetFullName() end)
        if ok and (full == path or "=" .. full == path or "@" .. full == path) then return sc end
    end
    -- v12: lewat lingkungan fungsi pemanggil (getfenv(fn).script)
    if type(fn) == "function" and type(getfenv) == "function" then
        local ok, sc = pcall(function() return getfenv(fn).script end)
        if ok and typeof(sc) == "Instance" then return sc end
    end
    -- v12: cari nama script (bagian terakhir jalur) di seluruh game + instance nil
    local last = string.match(path, "([^%.]+)$") or path
    local pools = { game:GetDescendants() }
    if type(getnilinstances) == "function" then
        local ok, arr = pcall(getnilinstances)
        if ok and type(arr) == "table" then pools[#pools + 1] = arr end
    end
    for _, pool in ipairs(pools) do
        for _, o in ipairs(pool) do
            if o.Name == last and (o:IsA("LocalScript") or o:IsA("ModuleScript") or o:IsA("Script")) then return o end
        end
    end
    return nil
end
-- potongan kode di sekitar kata kunci (±n baris), digabung kalau bertumpuk
local function windows(txt, keys, n, cap)
    local lines = string.split(txt, "\n")
    local mark = {}
    for i, l in ipairs(lines) do
        for _, k in ipairs(keys) do
            if string.find(l, k, 1, true) then
                for j = math.max(1, i - n), math.min(#lines, i + n) do mark[j] = true end
                break
            end
        end
    end
    local out, last, size = {}, 0, 0
    for i = 1, #lines do
        if mark[i] then
            if last ~= 0 and i ~= last + 1 then out[#out + 1] = "      ..." end
            local l = ("%5d  %s"):format(i, lines[i])
            out[#out + 1] = l
            size += #l
            last = i
            if size > cap then out[#out + 1] = "      ... (dipotong)" break end
        end
    end
    return table.concat(out, "\n")
end
local function gameCode()
    local out = { "-- SkyP Title Visual v13: KODE GAME (decompile) untuk warna & efek title" }
    -- 1) modul Roles utuh (fungsi titleOf, tagColor, nameCode, tagText, ...)
    local ri = findRolesInst()
    if ri then
        local txt, err = decompileText(ri)
        out[#out + 1] = "== Modul Roles: " .. ri:GetFullName() .. " =="
        out[#out + 1] = txt and (#txt > 60000 and (string.sub(txt, 1, 60000) .. "\n... (dipotong)") or txt) or ("gagal: " .. tostring(err))
        -- v12: modul BitmapText (yang menggambar kode warna "`w" dan kode efek "`{title}")
        local bt = ri.Parent and ri.Parent:FindFirstChild("BitmapText")
        if not bt and type(getloadedmodules) == "function" then
            -- nama modul diacak game: cari modul yang COLORS.d-nya sama dengan Roles.DEVELOPER_COLOR
            local dev = rawget(R, "DEVELOPER_COLOR")
            for _, m in ipairs(getloadedmodules()) do
                local ok, v = tryRequire(m)
                if ok and type(v) == "table" and type(rawget(v, "COLORS")) == "table" and dev ~= nil and v.COLORS.d == dev then
                    bt = m
                    break
                end
            end
        end
        if bt then
            local t2, e2 = decompileText(bt)
            out[#out + 1] = "== Modul BitmapText: " .. bt:GetFullName() .. " =="
            out[#out + 1] = t2 and (#t2 > 80000 and (string.sub(t2, 1, 80000) .. "\n... (dipotong)") or t2) or ("gagal: " .. tostring(e2))
        end
    else
        out[#out + 1] = "== Modul Roles: instance tidak ketemu =="
    end
    -- 2) script penggambar nama (yang memanggil tagText / legendOn / titleOf)
    local done = {}
    for _, nm in ipairs({ "tagText", "nameCode", "badgeOf", "legendOn", "titleOf" }) do
        local path = F.SrcFull[nm]
        if path and not done[path] then
            done[path] = true
            local inst = findByPath(path, F.SrcFn[nm])
            out[#out + 1] = ("== Script pemanggil %s: %s =="):format(nm, path)
            if inst then
                local txt, err = decompileText(inst)
                if txt then
                    out[#out + 1] = ("(%d huruf, %d baris) potongan di sekitar fungsi title:"):format(#txt, #string.split(txt, "\n"))
                    out[#out + 1] = windows(txt, { "legendOn", "titleOf", "tagText", "nameCode", "tagColor", "lineName",
                        "badgeOf", "tagSize", "wrenchOf", "guildTag", "drOn", "rainbow", "Rainbow", "fromHSV", "ImageColor3" }, 30, 45000)
                else
                    out[#out + 1] = "gagal: " .. tostring(err)
                end
            else
                out[#out + 1] = "instance script tidak ketemu"
            end
        end
    end
    if not next(done) then out[#out + 1] = "== Script pemanggil belum tercatat: pilih title & keluar-masuk world dulu ==" end
    return table.concat(out, "\n")
end
