-- v10: KATALOG. Tiap title dicoba satu per satu (dalam satu langkah, tanpa jeda) lewat fungsi game yang sudah dibungkus,
-- lalu dicatat apa yang berubah: teks nama, kode warna, ukuran, badge, wrench. Ditambah varian of Legend & Dr.
local function catalog()
    if not R then return nil end
    local save = { F.On, F.Title, F.Legend, F.Dr, F.Guild }
    local nameFn = rawget(R, "nameOf")
    local okN, myShown = pcall(nameFn, LocalPlayer)
    myShown = okN and type(myShown) == "string" and myShown or myName
    local function call(nm, ...)
        local fn = rawget(R, nm)
        if type(fn) ~= "function" then return "-" end
        local r = { pcall(fn, ...) }
        if not r[1] then return "ERR" end
        return short(r[2])
    end
    local function row(label)
        return ("%-24s teks=%s | warna(lineName)=%s | kode=%s | ukuran=%s | badge=%s | wrench=%s | tagColor=%s"):format(
            label, call("tagText", myShown, myId), call("lineName", myShown, myId, nil, nil), call("nameCode", myId),
            call("tagSize", myId), call("badgeOf", myId), call("wrenchOf", myId), call("tagColor", myId))
    end
    local out = { "-- SkyP Title Visual v10: KATALOG SEMUA TITLE (dicoba di nama sendiri, hanya layar sendiri)",
        "-- kode warna gaya Growtopia: w putih, 2 hijau, 4 merah, dst. Kode di depan nama: `kode...``" }
    F.On, F.Guild = true, nil
    F.Legend, F.Dr, F.Title = false, false, nil
    out[#out + 1] = row("(tanpa title)")
    for _, t in ipairs(TITLES) do
        F.Legend, F.Dr, F.Title = false, false, t.key
        out[#out + 1] = row(t.name .. " [" .. t.key .. "]")
    end
    out[#out + 1] = "-- varian"
    F.Title, F.Legend, F.Dr = nil, true, false
    out[#out + 1] = row("of Legend (legendOn)")
    F.Legend, F.Dr = false, true
    out[#out + 1] = row("Dr. (drOn)")
    F.Legend, F.Dr = true, true
    out[#out + 1] = row("Dr. + of Legend")
    F.On, F.Title, F.Legend, F.Dr, F.Guild = save[1], save[2], save[3], save[4], save[5]
    -- semua isi modul Roles (tabel & nilai), supaya tidak ada yang terlewat
    out[#out + 1] = "-- isi modul Roles"
    local keys = {}
    for k in pairs(R) do keys[#keys + 1] = tostring(k) end
    table.sort(keys)
    for _, k in ipairs(keys) do
        local v = rawget(R, k)
        if type(v) == "table" then
            local parts = {}
            for kk, vv in pairs(v) do parts[#parts + 1] = tostring(kk) .. "=" .. short(vv) end
            table.sort(parts)
            out[#out + 1] = ("   %s = { %s }"):format(k, table.concat(parts, ", "))
        elseif type(v) ~= "function" then
            out[#out + 1] = ("   %s = %s"):format(k, short(v))
        end
    end
    local fns = {}
    for _, k in ipairs(keys) do if type(rawget(R, k)) == "function" then fns[#fns + 1] = k end end
    out[#out + 1] = "   fungsi: " .. table.concat(fns, ", ")
    return table.concat(out, "\n")
end
