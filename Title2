-- v7: warna huruf nama. Warna asli tiap huruf dicatat; hanya huruf berwarna sama dengan huruf pertama
-- (nama + title) yang diwarnai, jadi tag guild "(GL)" tetap biru.
F.NameCol = { bm = nil, orig = {} }
local function colorRestore()
    local st = F.NameCol
    for l, c in pairs(st.orig) do pcall(function() if l.Parent then l.ImageColor3 = c end end) end
    st.bm, st.orig = nil, {}
end
local function colorTick(bm)
    local st = F.NameCol
    if st.bm ~= bm then colorRestore() st.bm = bm end
    local want = F.On and F.Color or nil
    -- warna utama = warna asli yang paling banyak dipakai huruf (bayangan hitam / tag guild tidak ikut)
    local kids, count, base, best = bm:GetChildren(), {}, nil, 0
    for _, l in ipairs(kids) do
        if l:IsA("ImageLabel") then
            if st.orig[l] == nil then st.orig[l] = l.ImageColor3 end
            local c = st.orig[l]
            if c.R + c.G + c.B > 0.45 then
                local k = math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
                count[k] = (count[k] or 0) + 1
                if count[k] > best then best, base = count[k], c end
            end
        end
    end
    for _, l in ipairs(kids) do
        local o = l:IsA("ImageLabel") and st.orig[l]
        if o then
            local target = (want and base and o == base) and want or o
            if l.ImageColor3 ~= target then l.ImageColor3 = target end
        end
    end
    for l in pairs(st.orig) do
        if l.Parent ~= bm then st.orig[l] = nil end -- huruf lama (nama digambar ulang)
    end
end

local function badgeTick()
    if not (F.On and R and (F.Title or F.Color or next(F.NameCol.orig))) then badgeClear() fixRestore() colorRestore() return end
    -- nametag yang sudah ketemu dipakai terus; dicari ulang paling sering tiap 1 detik (hemat)
    local bm = F.TagBm
    if not (bm and bm.Parent and bm:IsDescendantOf(game) and shown(bm)) then
        bm = nil
        if os.clock() - (F.TagScanAt or 0) >= 1 then
            F.TagScanAt = os.clock()
            bm = findOwnTag()
        end
        F.TagBm = bm
    end
    if not bm then return end
    pcall(colorTick, bm) -- v8: F.Color selalu nil -> hanya mengembalikan warna asli kalau sempat diubah
    if not (F.Badge and F.Title) then badgeClear() fixRestore() return end
    local b = tbl("TITLE_BADGES")
    local e = b and b[F.Title]
    local img = type(e) == "table" and rawget(e, "image") or e
    local holder = bm.Parent
    pcall(wrenchTick, holder)
    if type(img) ~= "string" then badgeClear() return end -- Legend: bola emas digambar game sendiri
    -- v6: game sudah memasang gambar badge di slot bendera, tapi potongannya masih potongan bendera (16x16).
    -- Potongan dibetulkan -> badge asli game tampil di tempat aslinya.
    local cell0 = type(e) == "table" and tonumber(rawget(e, "cell")) or nil
    for _, o in ipairs(holder:GetChildren()) do
        if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Name ~= "SkyPBadge" and o.Image == img then
            if not F.Fixed[o] then F.Fixed[o] = { off = o.ImageRectOffset, size = o.ImageRectSize } end
            local want = cell0 and Vector2.new(cell0, cell0) or Vector2.zero
            if o.ImageRectOffset ~= Vector2.zero then o.ImageRectOffset = Vector2.zero end
            if o.ImageRectSize ~= want then o.ImageRectSize = want end
            if o.ScaleType ~= Enum.ScaleType.Fit then o.ScaleType = Enum.ScaleType.Fit end
            badgeClear()
            return
        end
    end
    if not badgeObj or badgeObj.Parent ~= holder then
        badgeClear()
        badgeObj = Instance.new("ImageLabel")
        badgeObj.Name = "SkyPBadge"
        badgeObj.BackgroundTransparency = 1
        badgeObj.ScaleType = Enum.ScaleType.Fit
        badgeObj.ZIndex = bm.ZIndex + 1
        badgeObj.Parent = holder
    end
    local scale = type(e) == "table" and tonumber(rawget(e, "scale")) or 1
    local cell = type(e) == "table" and tonumber(rawget(e, "cell")) or nil
    local H = bm.AbsoluteSize.Y
    local size = math.floor(H * 1.25 * scale + 0.5)
    badgeObj.Image = img
    badgeObj.ImageRectSize = cell and Vector2.new(cell, cell) or Vector2.zero
    badgeObj.ImageRectOffset = Vector2.zero
    badgeObj.Size = UDim2.fromOffset(size, size)
    local list = holder:FindFirstChildOfClass("UIListLayout")
    if list then
        badgeObj.LayoutOrder = -1000
    else
        local hp = holder.AbsolutePosition
        local p = bm.AbsolutePosition
        badgeObj.Position = UDim2.fromOffset(math.floor(p.X - hp.X - size - 3), math.floor(p.Y - hp.Y + (H - size) / 2))
    end
end
